---
// Discipline card — splash + 404 primary nav. Used in <a> form so the whole card
// is the click target.
//
// 2026-06-26 (redesign): charcoal liquid-glass panel (four-layer warp/tint/edge/
//   content stack, sharing #glass-distortion from Base.astro), straight, one
//   material. Disciplines read by label + a flat single-stroke icon (Feather
//   family) in the top-right, aligned on a row with the card number. Empty cards
//   link to a coming-soon stub.
import type { Category } from '../content/categories';

interface Props {
  category: Category;
  k: 1 | 2 | 3 | 4;
  index: 1 | 2 | 3 | 4;
  isEmpty?: boolean;
}
const { category, k, index, isEmpty = false } = Astro.props;

const cardLabel: Record<Category, string> = {
  design:    'Graphic Design',
  finance:   'Financial Models',
  personal:  'Personal Projects',
  saas: 'SaaS',
};

// One-line role lens so a recruiter maps each room to the kind of role it
// speaks to. Sentence case, no em dashes, no banned filler.
const cardLens: Record<Category, string> = {
  design:    'Brand systems and visual identity',
  finance:   'Models, analysis, and the numbers',
  personal:  'Range, side projects, and play',
  saas: 'Product thinking and building',
};

const cueText = isEmpty ? 'In the works →' : 'View the work →';
const cls = `b-card k${k}${isEmpty ? ' is-empty' : ''}`;
---
<a
  href={`/${category}`}
  id={`card-${category}`}
  class={cls}
  aria-label={isEmpty ? `${cardLabel[category]} — coming soon` : undefined}
>
  {/* Liquid-glass layers (refraction → milky body → lit bevel). Decorative. */}
  <span class="bc-warp" aria-hidden="true"></span>
  <span class="bc-tint" aria-hidden="true"></span>
  <span class="bc-edge" aria-hidden="true"></span>

  {/* Top row: card number (left) and discipline icon (right), aligned. */}
  <div class="bc-top">
    <span class="b-card-no">0{index} / 04</span>
    <span class="bc-icon" aria-hidden="true">
      {category === 'design' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 20h9" />
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
        </svg>
      )}
      {category === 'finance' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="20" x2="18" y2="10" />
          <line x1="12" y1="20" x2="12" y2="4" />
          <line x1="6" y1="20" x2="6" y2="14" />
        </svg>
      )}
      {category === 'personal' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
        </svg>
      )}
      {category === 'saas' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" />
        </svg>
      )}
    </span>
  </div>

  <div class="b-card-mid">
    <span class="b-card-name">{cardLabel[category]}</span>
    <span class="b-card-lens">{cardLens[category]}</span>
  </div>
  <span class="b-card-cue">{cueText}</span>
</a>

<style>
  .b-card {
    --rest-rotate: 0deg; /* straight — entrance/click shake keyframes compose against this */
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    isolation: isolate;
    padding: 22px 22px 24px;
    cursor: pointer;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 4px;
    min-height: 210px;
    text-decoration: none;
    color: var(--paper);
    box-shadow: 0 22px 48px -26px rgba(10, 10, 10, 0.7);
    transition: transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.32s ease;
  }

  /* --- Liquid-glass four-layer stack (warp → tint → edge → content) --- */
  .b-card .bc-warp {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    backdrop-filter: blur(3px) saturate(1.3);
    -webkit-backdrop-filter: blur(3px) saturate(1.3);
    filter: url(#glass-distortion);
    pointer-events: none;
  }
  .b-card .bc-tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background: rgba(12, 11, 10, 0.55);
    pointer-events: none;
    transition: background 0.32s ease;
  }
  .b-card .bc-edge {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    border: 1px solid rgba(255, 255, 255, 0.20);
    box-shadow:
      inset 1.5px 1.5px 1px rgba(255, 255, 255, 0.40),
      inset -1px -1px 1px rgba(255, 255, 255, 0.16),
      inset 0 0 22px rgba(255, 255, 255, 0.05);
    pointer-events: none;
  }
  /* content above the glass */
  .b-card > .bc-top,
  .b-card > .b-card-mid,
  .b-card > .b-card-cue {
    position: relative;
    z-index: 3;
  }

  .b-card:focus-visible {
    outline: 3px solid var(--paper);
    outline-offset: 4px;
  }

  .b-card.is-empty { opacity: 0.82; }
  .b-card.is-empty .b-card-cue {
    font-style: italic;
    opacity: 0.78;
  }

  /* Top row — number left, icon right, vertically centred on the same line. */
  .bc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .b-card-no {
    font-family: var(--mono);
    font-size: var(--fs-card-no);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.8;
  }
  .bc-icon {
    display: inline-flex;
    color: var(--paper);
    opacity: 0.9;
  }
  .bc-icon svg {
    width: 26px;
    height: 26px;
    display: block;
  }

  .b-card-name {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(24px, 2.9vw, 38px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    align-self: end;
  }
  .b-card-lens {
    display: block;
    margin-top: var(--sp-1);
    font-size: var(--fs-tile-role);
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--paper);
    opacity: 0.68;
  }
  .b-card-cue {
    font-family: var(--mono);
    font-size: var(--fs-card-no);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    align-self: end;
    margin-top: var(--sp-2);
    opacity: 0.85;
  }

  /* Hover: clean straight lift + slightly clearer glass. */
  @media (hover: hover) and (pointer: fine) {
    .b-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 30px 60px -24px rgba(10, 10, 10, 0.8);
      z-index: 10;
    }
    .b-card:hover .bc-tint { background: rgba(12, 11, 10, 0.46); }
  }

  /* Entrance: a sheen of light flows once around the border with a soft glow
     bloom — the Apple "light travels through the edge" look. Replaces the old
     entrance shake. Fires on scroll-in via .is-entered (JS below), all devices. */
  @property --sheen-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  /* The comet: a conic sweep masked to a 1.4px ring on the perimeter. */
  .b-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    border-radius: inherit;
    padding: 1.4px;
    background: conic-gradient(from var(--sheen-angle),
      rgba(242, 235, 219, 0) 0deg,
      rgba(242, 235, 219, 0) 50deg,
      rgba(242, 235, 219, 0.85) 84deg,
      rgba(255, 251, 240, 1) 90deg,
      rgba(242, 235, 219, 0) 98deg,
      rgba(242, 235, 219, 0) 360deg);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0;
    pointer-events: none;
  }
  .b-card.is-entered::after {
    animation: border-flow 1500ms cubic-bezier(0.22, 0.61, 0.36, 1) 1;
  }
  @keyframes border-flow {
    0%   { opacity: 0; --sheen-angle: 0deg; }
    10%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { opacity: 0; --sheen-angle: 400deg; }
  }

  /* Glow bloom, synced with the comet — outer light that the box-shadow carries
     (overflow:hidden clips children, not box-shadow). Endpoints match the rest
     shadow so it settles with no jump. */
  .b-card.is-entered {
    animation: border-glow 1500ms ease-out 1;
  }
  @keyframes border-glow {
    0%   { box-shadow: 0 22px 48px -26px rgba(10, 10, 10, 0.7), 0 0 0 0 rgba(242, 235, 219, 0); }
    35%  { box-shadow: 0 22px 48px -26px rgba(10, 10, 10, 0.7), 0 0 26px 1px rgba(242, 235, 219, 0.16); }
    100% { box-shadow: 0 22px 48px -26px rgba(10, 10, 10, 0.7), 0 0 0 0 rgba(242, 235, 219, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .b-card.is-entered,
    .b-card.is-entered::after { animation: none; }
  }

  /* Click feedback — a quick tactile shake, separate from the entrance. */
  @keyframes card-shake-click {
    0%   { transform: rotate(var(--rest-rotate)); }
    40%  { transform: rotate(calc(var(--rest-rotate) - 1.6deg)) translateX(-1.4px); }
    100% { transform: rotate(var(--rest-rotate)); }
  }
  .b-card.is-shaking {
    animation: card-shake-click 220ms ease-out 0ms 1 !important;
  }

  @media (max-width: 900px) {
    .b-card { padding: 20px 20px 22px; min-height: 158px; }
    .bc-icon svg { width: 22px; height: 22px; }
  }
  @media (max-width: 520px) {
    .b-card-name { font-size: clamp(22px, 7vw, 30px); }
  }
</style>

<script>
  // Entrance border-flow — add .is-entered on first viewport intersection so the
  // sheen + glow keyframes fire once per card. All devices; skipped under
  // reduced-motion (the CSS also no-ops the animation as a belt-and-braces guard).
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  function enableEntrance() {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-entered');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.4 });
    document.querySelectorAll('.b-card, .b-bio').forEach((el) => observer.observe(el));
  }

  // Hold the glimmer until the intro overlay finishes (so cards don't light up
  // behind it). Pages without an intro (e.g. 404) start immediately.
  const startEntrance = () => { if (!prefersReduced.matches) enableEntrance(); };
  const introEl = document.querySelector('[data-intro]');
  if (!introEl || (window as any).__introDone) {
    startEntrance();
  } else {
    document.addEventListener('intro:done', startEntrance, { once: true });
  }

  prefersReduced.addEventListener?.('change', (e) => {
    if (!e.matches && ((window as any).__introDone || !document.querySelector('[data-intro]'))) {
      enableEntrance();
    }
  });
</script>

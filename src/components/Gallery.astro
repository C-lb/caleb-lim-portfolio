---
// Uniform gallery grid. 2026-06-26: replaces the three near-duplicate buckets
// (GalleryA12 / B35 / C68) whose spanning tiles blew a single piece up to a
// full-bleed slab. Every piece is now an equal, properly-sized clickable card
// (thumbnail + title + role) on a 12-column grid — 3 across on desktop, 2 on
// tablet, 1 on phone — that simply wraps and scrolls down the page. Scales the
// same from 1 piece to many.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { Category } from '../content/categories';

interface Props {
  pieces: CollectionEntry<'pieces'>[];
  category: Category;
}
const { pieces, category } = Astro.props;
---
<ul class="gallery" role="list">
  {pieces.map((piece, i) => (
    <li>
      <a href={`/${category}/${piece.id}`} class="g-card">
        <div class="g-thumb">
          <Image
            src={piece.data.hero}
            alt={piece.data.title}
            class="g-cover"
            priority={i === 0}
            widths={[320, 640]}
            sizes="(max-width: 600px) 100vw, (max-width: 1024px) 50vw, 360px"
          />
        </div>
        <div class="g-meta">
          <h3 class="g-ttl">{piece.data.title}</h3>
          <span class="g-role">{piece.data.role}</span>
          <span class="g-cue">View piece →</span>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .gallery {
    margin-top: var(--sp-6);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 360px));
    justify-content: center;
    gap: var(--sp-5);
    list-style: none;
    padding: 0;
  }
  .gallery > li { min-width: 0; }

  /* Glass card on the dark category canvas: translucent fill lighter than the
     canvas, a lit top bevel and rim instead of a stroke, soft diffuse shadow. */
  .g-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: var(--paper);
    background: var(--glass-fill);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow:
      inset 0 1px 0 var(--glass-lit),
      inset 0 0 0 1px var(--glass-rim),
      var(--glass-shadow);
    transition: transform 0.22s ease, box-shadow 0.22s ease, background 0.22s ease;
  }
  /* Contain the whole screenshot on the neutral work surface (matches the
     featured card + carousel covers) instead of cover-cropping tall shots
     into a zoomed blob. */
  .g-thumb {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--work-canvas);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-4);
  }
  .g-cover {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 12px 26px -14px rgba(0, 0, 0, 0.6);
    transition: transform 0.35s ease;
  }
  .g-meta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-4);
  }
  .g-ttl {
    font-family: var(--sans);
    font-weight: 700;
    font-size: var(--fs-ttl);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .g-role {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--fs-tile-role);
    line-height: 1.3;
    opacity: 0.82;
  }
  .g-cue {
    margin-top: var(--sp-1);
    font-family: var(--mono);
    font-size: var(--fs-card-no);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  @media (hover: hover) and (pointer: fine) {
    .g-card:hover {
      transform: translateY(-3px);
      background: var(--glass-fill-hi);
      box-shadow:
        inset 0 1px 0 var(--glass-lit),
        inset 0 0 0 1px var(--glass-rim),
        var(--glass-shadow-hi);
    }
    .g-card:hover .g-cover { transform: scale(1.03); }
  }
  .g-card:focus-visible {
    outline: 3px solid var(--paper);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .g-card, .g-cover { transition: none; }
  }

  /* Phone: tighten gap, let cards stretch full-width. */
  @media (max-width: 600px) {
    .gallery {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: var(--sp-4);
    }
  }
</style>

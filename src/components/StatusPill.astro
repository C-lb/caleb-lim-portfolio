---
// Status pill — fixed "dynamic island" pinned top-center, links to /about#contact.
// 2026-06-26: rebuilt as a liquid-glass pill (warp/tint/edge layers sharing
// #glass-distortion from Base.astro) instead of a flat ink fill. Degrades to clean
// frosted glass outside Chromium.
---
<div class="pill-island">
  <a class="pill" href="/about?to=contact" aria-label="Open to roles — go to contact section" data-tip="View about me">
    <span class="sp-warp" aria-hidden="true"></span>
    <span class="sp-tint" aria-hidden="true"></span>
    <span class="sp-edge" aria-hidden="true"></span>
    <span class="sp-content"><span class="dot" aria-hidden="true"></span>OPEN TO ROLES</span>
  </a>
</div>

<style>
  /* Fixed top-center; clicks pass through the gutter, the pill re-enables them. */
  .pill-island {
    position: fixed;
    top: 12px;
    left: 0;
    right: 0;
    width: 100vw;
    display: flex;
    justify-content: center;
    pointer-events: none;
    z-index: 90;
  }
  .pill {
    pointer-events: auto;
    position: relative;
    /* No overflow:hidden — the glass layers clip themselves via border-radius so
       the [data-tip] tooltip below the pill isn't clipped. */
    isolation: isolate;
    background: transparent;
    color: var(--paper);
    text-decoration: none;
    border-radius: 999px;
    cursor: pointer;
    /* Floating-island drop shadow (the bevel comes from .sp-edge). */
    box-shadow:
      0 10px 28px rgba(0, 0, 0, 0.30),
      0 2px 6px rgba(0, 0, 0, 0.18);
    transition: transform 240ms cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 240ms ease;
  }

  /* --- Liquid-glass stack --- */
  .pill .sp-warp {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    backdrop-filter: blur(2px) saturate(1.2);
    -webkit-backdrop-filter: blur(2px) saturate(1.2);
    filter: url(#glass-distortion);
    pointer-events: none;
  }
  .pill .sp-tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background: rgba(12, 11, 10, 0.60);
    pointer-events: none;
  }
  .pill .sp-edge {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow:
      inset 1px 1px 1px rgba(255, 255, 255, 0.35),
      inset -1px -1px 1px rgba(255, 255, 255, 0.12),
      inset 0 0 14px rgba(255, 255, 255, 0.05);
    pointer-events: none;
  }
  .sp-content {
    position: relative;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    padding: 9px 20px;
    font-family: var(--mono);
    font-size: var(--fs-mono);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .pill:hover {
      transform: scale(1.04);
      box-shadow:
        0 14px 34px rgba(0, 0, 0, 0.34),
        0 3px 8px rgba(0, 0, 0, 0.20);
    }
  }
  .pill:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 3px;
  }
  .pill .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #46c46a; /* green "open" signal (was lime) */
    margin-right: 9px;
    box-shadow: 0 0 6px rgba(70, 196, 106, 0.6);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.4; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pill { transition: none; }
    .pill:hover { transform: none; }
    .pill .dot { animation: none; }
  }
  /* Phones: stop floating the pill over the topbar. It un-fixes and becomes its
     own full-width, centred row inside the (now wrapping) topbar — order:3 puts it
     below the brand + icon nav. Eliminates the centre-pill / nav-icon overlap that
     occurs on narrow screens where brand + pill + 4 icons can't share one row. */
  @media (max-width: 700px) {
    .pill-island {
      position: static;
      width: 100%;
      order: 3;
      margin-top: 2px;
    }
    .sp-content { padding: 8px 14px; }
  }
</style>

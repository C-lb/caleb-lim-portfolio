---
// Site-wide short-form toggle, rendered inside each page's directional pill
// row (DisciplineNav on room pages, the back/pager row on case studies).
// Behaviour lives in Base.astro's global script: it binds every
// [data-shortform-toggle], flips the root data-shortform attribute, and
// persists the choice in localStorage. aria-pressed is synced there too.
interface Props {
  /* Match the surrounding pills: 999 for the round case-study pills,
     10 for the squarer room chips. */
  radius?: number;
}
const { radius = 999 } = Astro.props;
---
<button
  type="button"
  class="sf-toggle"
  style={`--sf-radius: ${radius}px`}
  aria-pressed="false"
  data-shortform-toggle
  data-tip="Condense case-study text to the core lines"
>
  <span class="sf-dot" aria-hidden="true"></span>
  <span>Short form</span>
</button>

<style>
  /* Neutral grey chip in the same raised-pill family as its neighbours; the
     state lives entirely in the dot (owner request 2026-08-06, explicit
     override of the semantic-colour default): red dot = off, green dot with a
     soft radiating pulse = on. */
  .sf-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 8px 16px;
    border: none;
    border-radius: var(--sf-radius);
    cursor: pointer;
    background: rgba(242, 235, 219, 0.06);
    color: var(--paper);
    font-family: var(--mono);
    font-size: var(--fs-mono);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 10px 24px -16px rgba(0, 0, 0, 0.6);
    transition: background 0.2s ease;
  }
  .sf-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d4574a;
    flex: none;
    transition: background 0.25s ease;
  }
  .sf-toggle[aria-pressed="true"] .sf-dot {
    background: #6bbe8a;
    animation: sf-pulse 1.8s ease-out infinite;
  }
  @keyframes sf-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(107, 190, 138, 0.55); }
    70%  { box-shadow: 0 0 0 7px rgba(107, 190, 138, 0); }
    100% { box-shadow: 0 0 0 0 rgba(107, 190, 138, 0); }
  }
  @media (hover: hover) and (pointer: fine) {
    .sf-toggle:hover { background: rgba(242, 235, 219, 0.13); }
  }
  .sf-toggle:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sf-toggle { transition: none; }
    .sf-toggle[aria-pressed="true"] .sf-dot { animation: none; }
  }
</style>

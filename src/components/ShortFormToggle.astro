---
// Site-wide short-form toggle, rendered inside each page's directional pill
// row (DisciplineNav on room pages, the back/pager row on case studies).
// Behaviour lives in Base.astro's global script: it binds every
// [data-shortform-toggle], flips the root data-shortform attribute, and
// persists the choice in localStorage. aria-pressed is synced there too.
interface Props {
  /* Match the surrounding pills: 999 for the round case-study pills,
     10 for the squarer room chips. */
  radius?: number;
}
const { radius = 999 } = Astro.props;
---
<button
  type="button"
  class="sf-toggle"
  style={`--sf-radius: ${radius}px`}
  aria-pressed="false"
  data-shortform-toggle
  data-tip="Condense case-study text to the core lines"
>
  <span class="sf-dot" aria-hidden="true"></span>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <line x1="4" y1="7" x2="20" y2="7" />
    <line x1="4" y1="12" x2="14" y2="12" />
    <line x1="4" y1="17" x2="9" y2="17" />
  </svg>
  <span>Short form</span>
</button>

<style>
  /* State is colour-coded by owner request (2026-08-06, explicit override of
     the semantic-colour default): red chip = off, green chip with a soft
     radiating pulse = on. Same raised-chip family as the pills around it:
     flat fill, lit top edge, soft diffuse shadow, mono uppercase, 2:1 padding. */
  .sf-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    padding: 8px 16px;
    border: none;
    border-radius: var(--sf-radius);
    cursor: pointer;
    background: #7e332c;
    color: var(--paper);
    font-family: var(--mono);
    font-size: var(--fs-mono);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.1),
      0 10px 24px -16px rgba(0, 0, 0, 0.6);
    transition: background 0.25s ease, color 0.25s ease;
  }
  .sf-toggle svg { flex: none; }
  /* The dot mirrors the chip state one step brighter, so on/off reads even at
     a glance from the corner of the eye. */
  .sf-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e58a80;
    flex: none;
    transition: background 0.25s ease;
  }
  /* Pressed = on: green chip, brighter dot, soft green pulse radiating out. */
  .sf-toggle[aria-pressed="true"] {
    background: #37664a;
    animation: sf-pulse 1.8s ease-out infinite;
  }
  .sf-toggle[aria-pressed="true"] .sf-dot {
    background: #8fd8a8;
  }
  @keyframes sf-pulse {
    0%   { box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 0 0 0 rgba(107, 190, 138, 0.45); }
    70%  { box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 0 0 12px rgba(107, 190, 138, 0); }
    100% { box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 0 0 0 rgba(107, 190, 138, 0); }
  }
  @media (hover: hover) and (pointer: fine) {
    .sf-toggle[aria-pressed="false"]:hover { background: #93413a; }
    .sf-toggle[aria-pressed="true"]:hover  { background: #3f7554; }
  }
  .sf-toggle:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .sf-toggle { transition: none; animation: none; }
    .sf-toggle[aria-pressed="true"] { animation: none; }
  }
</style>

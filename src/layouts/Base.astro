---
// Phase 3 D-18 Base layout. Every page extends this.
// Imports tokens, fontsource CSS, preloads Bricolage display woff2.
import '../styles/tokens.css';
// 2026-06-26: site-wide type swap. DM Sans (anti-vibecode sans set) now carries
// BOTH the former sans (Bricolage) and serif (Fraunces) roles — see tokens.css.
// Italic face imported so the old serif-italic accents render as true DM Sans
// italics rather than browser-synthesised oblique. JetBrains Mono (labels/
// eyebrows) is unchanged.
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/dm-sans/wght-italic.css';
// carousel vibe fonts
import '@fontsource-variable/dancing-script';
import '@fontsource/bungee';
import '@fontsource-variable/unbounded';
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/dynapuff';
import '@fontsource/zilla-slab/400.css';
import '@fontsource/zilla-slab/600.css';
// Preload the DM Sans display woff2 actually used above the fold.
// Canonical Fontsource v5 file name for the Latin variable-wght file.
import dmSansDisplay from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import StatusPill from '../components/StatusPill.astro';

interface Props {
  title: string;
  bg?: 'paper' | 'ink';
  description?: string;
  ogImage?: string;
}
const { title, bg = 'paper', description, ogImage = '/og.png' } = Astro.props;
const isHome = Astro.url.pathname === '/';
const desc = description ?? 'Caleb Lim works across brand and design, financial models, product, and side projects.';
const ogUrl = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href={dmSansDisplay} crossorigin="anonymous" />
  </head>
  <body class={`bg-${bg}`}>
    {/* Liquid-glass refraction filter — one shared definition per page, referenced
        by every glass element's .warp layer (currently the splash/404 discipline
        cards). feTurbulence makes a smooth noise field; feDisplacementMap shoves
        the blurred backdrop by it, bending what's behind. Refraction only shows in
        Chromium and only over busy backdrops — elsewhere it degrades to clean
        frosted blur, which is intended. */}
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="glass-distortion" x="-20%" y="-20%" width="140%" height="140%" filterUnits="objectBoundingBox">
        <feTurbulence type="fractalNoise" baseFrequency="0.008 0.008" numOctaves="2" seed="42" result="noise" />
        <feGaussianBlur in="noise" stdDeviation="2" result="blurred" />
        <feDisplacementMap in="SourceGraphic" in2="blurred" scale="48" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <a href="#main" class="skip">Skip to content</a>
    <header class="topbar">
      <a href="/" class="brand" aria-current={isHome ? 'page' : undefined} data-tip="You're looking at him, yo!" data-tip-left>caleb lim</a>
      <StatusPill />
      <nav aria-label="primary">
        <a href="mailto:caleb.lim.2024@smu.edu.sg" class="nav-link" aria-label="Email Caleb" data-tip="Click to copy" data-copy-email>
          <span class="nav-text">email</span>
          <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 3 5 h 18 v 14 h -18 z" />
            <path d="M 3 5 l 9 7 l 9 -7" />
          </svg>
        </a>
        <a href="https://t.me/lebbeh" target="_blank" rel="noopener noreferrer" class="nav-link" aria-label="Copy Caleb's Telegram, @lebbeh" data-tip="Click to copy" data-copy-telegram>
          <span class="nav-text">telegram</span>
          <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13" />
            <polygon points="22 2 15 22 11 13 2 9 22 2" />
          </svg>
        </a>
        <a href="https://linkedin.com/in/caleblkr" target="_blank" rel="noopener noreferrer" class="nav-link" aria-label="Caleb on LinkedIn" data-tip="Opens Caleb's page in a new tab">
          <span class="nav-text">linkedin</span>
          <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 4 9 v 11" />
            <path d="M 4 5 v 0.5" />
            <path d="M 10 20 v -11" />
            <path d="M 10 14 c 0 -3 4 -5 8 -5 v 11" />
          </svg>
        </a>
        <a href="/caleb-lim-resume.pdf" download class="nav-link" aria-label="Download Caleb's resume" data-tip="Click to download" data-tip-right data-download-resume>
          <span class="nav-text">resume</span>
          <svg class="nav-icon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 12 4 v 12" />
            <path d="M 6 11 l 6 6 l 6 -6" />
            <path d="M 4 21 h 16" />
          </svg>
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <span class="center">available for part-time, full-time internship roles<br />brand &nbsp;·&nbsp; analyst &nbsp;·&nbsp; design</span>
    </footer>
    <script>
      // Topbar button microinteractions (anti-vibecode confirm).
      // Email: copy to clipboard instead of opening a mail client, flash "Copied".
      // Resume: let the download proceed, flash "Saved". LinkedIn: tooltip only.
      const flashTip = (el: HTMLElement, text: string, ms = 1500) => {
        const orig = el.getAttribute('data-tip') ?? '';
        el.setAttribute('data-tip', text);
        el.classList.add('tip-flash', 'tip-success');
        window.setTimeout(() => {
          el.classList.remove('tip-flash', 'tip-success');
          el.setAttribute('data-tip', orig);
        }, ms);
      };

      const emailLink = document.querySelector<HTMLAnchorElement>('[data-copy-email]');
      emailLink?.addEventListener('click', async (e) => {
        e.preventDefault();
        const addr = (emailLink.getAttribute('href') ?? '').replace(/^mailto:/, '');
        try {
          await navigator.clipboard.writeText(addr);
          flashTip(emailLink, '✓ Copied');
        } catch {
          // Clipboard blocked (e.g. insecure context) — fall back to the mail client.
          window.location.href = 'mailto:' + addr;
        }
      });

      const telegramLink = document.querySelector<HTMLAnchorElement>('[data-copy-telegram]');
      telegramLink?.addEventListener('click', async (e) => {
        e.preventDefault();
        try {
          await navigator.clipboard.writeText('@lebbeh');
          flashTip(telegramLink, '✓ Copied');
        } catch {
          window.open('https://t.me/lebbeh', '_blank', 'noopener');
        }
      });

      const resumeLink = document.querySelector<HTMLAnchorElement>('[data-download-resume]');
      // Don't preventDefault — let the browser download the PDF; just confirm.
      resumeLink?.addEventListener('click', () => flashTip(resumeLink, '✓ Saved'));
    </script>
  </body>
</html>

<style is:global>
  /* Body background switches per page via bg='paper' | 'ink' prop.
     is:global is required so the body class selector wins (scoped styles hash). */
  body.bg-paper { background: var(--paper); color: var(--ink); }
  body.bg-ink   { background: var(--ink);   color: var(--paper); }
  /* Guard against phantom horizontal scroll on phones: decorative absolutely
     positioned elements (hover tooltips, off-screen carousel slides) can extend
     past the viewport and create a sliver of horizontal scroll. clip blocks page
     horizontal scroll without affecting vertical scroll or any inner scroll
     container (e.g. the discipline-card carousel keeps its own overflow-x). Clip
     on html too — body-only clip lets the overflow escape to the root, which stays
     visible, so the page still scrolls sideways. */
  html, body { overflow-x: clip; }
</style>

<style>
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--sp-5) var(--sp-6);
    font-family: var(--mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .topbar .brand {
    font-family: var(--mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.1em;
    text-transform: lowercase;
  }
  .topbar nav {
    display: flex;
    gap: 18px;
    min-width: 1px; /* reserves the grid slot for Phase 4 */
  }
  /* D-06 Touch-hover gate (Plan 05-07 Task 1). Nav-link color change on hover
     only on devices with a real hover mechanism. The ≤700px topbar collapse
     block below (Plan 05-03) is NOT touched — only this hover color rule moves
     into the gate. */
  /* Anti-vibecode raised treatment on hover. currentColor-based so it adapts to
     both the cream (ink text) and ink (paper text) topbar canvases: a faint chip
     surface, a lit top edge, and a soft drop shadow — no hard stroke. */
  @media (hover: hover) and (pointer: fine) {
    .topbar nav a.nav-link:hover {
      background: color-mix(in oklab, currentColor 10%, transparent);
      box-shadow:
        inset 0 1px 0 color-mix(in oklab, currentColor 22%, transparent),
        0 10px 22px -14px rgba(0, 0, 0, 0.55);
      transform: translateY(-1px);
    }
  }

  /* Phase 4 — header chrome links. Inherit .topbar typography; override text-transform to lowercase to match .brand.
     Phase 5 (Plan 05-03): padding bumped 4px 0 -> 12px 8px to clear WCAG 2.5.8 AA (≥24x24 tap floor). */
  .topbar nav .nav-link {
    font-family: var(--mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.1em;
    text-transform: lowercase;
    font-weight: 600;
    color: inherit;
    text-decoration: none;
    padding: 8px 16px; /* 2:1 — AV button padding */
    border-radius: 10px;
    transition: background 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }
  .topbar nav .nav-link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
  /* Phase 5 (Plan 05-03) — icon glyph is hidden above 700px; its sibling .nav-text carries the label. */
  .topbar nav .nav-icon {
    display: none;
    stroke: currentColor;
    fill: none;
  }
  /* aria-current="page" dim — only ever set on the brand link on splash (Pitfall P-4).
     pointer-events kept ON so the hover tooltip still fires on the home page (the
     link just re-navigates to /, which is harmless). */
  .topbar .brand[aria-current="page"] {
    opacity: 0.6;
  }
  /* Skip-to-content — visually hidden until focused (O-2). */
  .skip {
    position: absolute;
    top: 0;
    left: 0;
    padding: var(--sp-2) var(--sp-4);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    transform: translateY(-200%);
    transition: transform 0.15s ease-out;
    z-index: 100;
  }
  .skip:focus-visible {
    transform: translateY(0);
    outline: 2px solid var(--paper);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .skip { transition: none; }
  }

  .foot {
    display: flex;
    justify-content: center;
    padding: var(--sp-5) var(--sp-6);
    font-family: var(--mono);
    font-size: var(--fs-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .foot .center {
    text-align: center;
    font-family: var(--sans);
    font-style: normal;
    font-size: var(--fs-tile-role);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
  }

  @media (max-width: 900px) {
    .foot { justify-content: flex-start; }
    .foot .center { text-align: left; }
  }

  /* Phase 5 (Plan 05-03) — topbar mobile collapse per D-01/D-02/D-03.
     ≤700px: text labels hide, 44x44 icon row appears. Closes BLOCKER-1 (recruiter
     on iPhone Safari was seeing the resume link clipped off the right edge). */
  @media (max-width: 700px) {
    .topbar nav { gap: var(--sp-2); }
    .topbar nav .nav-text { display: none; }
    .topbar nav .nav-icon { display: block; }
    .topbar nav .nav-link {
      width: 44px;
      height: 44px;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    /* Two-row topbar on phones: brand + icon nav share the top row, the
       "open to roles" pill drops to its own centred row below (see StatusPill).
       This removes any chance of the fixed centre pill overlapping the icons on
       narrow screens (≤375px), where all three can't fit one row. Padding is
       trimmed so the two rows don't make the header too tall. */
    .topbar {
      flex-wrap: wrap;
      row-gap: var(--sp-2);
      padding: var(--sp-4) var(--sp-4);
    }
    .topbar .brand { order: 1; }
    .topbar nav { order: 2; }
  }
</style>

---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, type Category } from '../content/categories';
import { DISCIPLINE_ACCENT } from '../styles/disciplines';
import Gallery from '../components/Gallery.astro';
import DisciplineNav from '../components/DisciplineNav.astro';
import FeaturedPiece from '../components/FeaturedPiece.astro';
import PieceCarousel from '../components/PieceCarousel.astro';

export async function getStaticPaths() {
  // 2026-06-26: emit a route for EVERY discipline, populated or not. Empty ones
  // render a coming-soon stub (below) instead of dead-ending in a 404, so the
  // splash discipline cards are all clickable. Reverses the prior D-07 rule that
  // only emitted populated routes.
  return CATEGORIES.map((cat) => ({ params: { category: cat } }));
}

const { category } = Astro.params as { category: Category };

// Existing filter+sort idiom — Phase 1 D-01 contract (PATTERNS.md S3)
const pieces = (await getCollection('pieces', ({ data }) =>
  data.category === category && data.draft !== true
)).sort((a, b) => a.data.order - b.data.order);

const accent = DISCIPLINE_ACCENT[category];
const n = pieces.length;

// UI-SPEC Copywriting Contract overridden during phase-exit walk: drop slash.
const categoryLabel: Record<Category, string> = {
  design:    'GRAPHIC DESIGN',
  finance:   'FINANCIAL MODELS',
  personal:  'PERSONAL PROJECTS',
  saas: 'SAAS',
};
// Tab/<title> form is Title Case — readable in browser tab + bookmark + search results.
// 2026-05-18 (UAT): replaces the prior label.toLowerCase() which rendered tabs as
// "graphic design — Caleb Lim" (unprofessional). Tab-title spelling diverges from
// the on-page h2 (which stays UPPERCASE for the heavy-caps editorial composition).
const categoryTabTitle: Record<Category, string> = {
  design:    'Graphic Design',
  finance:   'Financial Models',
  personal:  'Personal Projects',
  saas: 'SaaS',
};
const label = categoryLabel[category];
const isEmpty = n === 0;

// Empty-room copy. Reads as a deliberate, honest note plus a strong push to the
// rooms that have work, not "still being hung" (which reads unfinished).
const comingSoonLead: Record<Category, string> = {
  design:    'No graphic design pieces are posted here yet.',
  finance:   'No financial models are posted here yet.',
  personal:  'Personal projects are not posted here yet.',
  saas: 'No SaaS work is posted here yet.',
};
const comingSoonBlurb: Record<Category, string> = {
  design:    'The work that is up lives in the other rooms. Start there.',
  finance:   'The work that is up lives in the other rooms. Start there.',
  personal:  'Side projects and experiments that do not fit a brief. The posted work lives in the other rooms.',
  saas: 'The work that is up lives in the other rooms. Start there.',
};

// Disciplines that already have work, for the "see what's ready" links on the stub.
const allPieces = await getCollection('pieces', ({ data }) => data.draft !== true);
const readyCategories = CATEGORIES.filter(
  (c) => allPieces.some((p) => p.data.category === c),
);
const readyLabel: Record<Category, string> = {
  design: 'Graphic Design', finance: 'Financial Models',
  personal: 'Personal Projects', saas: 'SaaS',
};
---
<Base title={`${categoryTabTitle[category]} — Caleb Lim`} bg="ink" description={`${categoryTabTitle[category]} by Caleb Lim.`}>
  <section class="b-category" style={`--accent: ${accent}`}>
    <header class="b-cat-head">
      <a href="/" class="b-cat-back">← Splash</a>
      <h2>{label}{isEmpty && <em> soon</em>}</h2>
      <span class="b-cat-meta">
        {isEmpty ? <strong>COMING SOON</strong> : <strong>UPDATED MAY 2026</strong>}
      </span>
    </header>

    <DisciplineNav current={category} />

    {n === 0 ? (
      <div class="b-coming">
        <p class="b-coming-lead">{comingSoonLead[category]}</p>
        <p class="b-coming-blurb">{comingSoonBlurb[category]}</p>
        {readyCategories.length > 0 && (
          <div class="b-coming-ready">
            <span class="b-coming-ready-label">Work that's ready now</span>
            <div class="b-coming-links">
              {readyCategories.map((c) => (
                <a class="b-coming-link" href={`/${c}`}>{readyLabel[c]} →</a>
              ))}
            </div>
          </div>
        )}
      </div>
    ) : n === 1 ? (
      <FeaturedPiece piece={pieces[0]} category={category} />
    ) : (
      <>
        <PieceCarousel pieces={pieces} accent={accent} theme="dark" label="Browse this room" />
        <FeaturedPiece piece={pieces[0]} category={category} />
        <Gallery pieces={pieces.slice(1)} category={category} />
      </>
    )}
  </section>
</Base>

<style>
  /* --- Sketch lines 533-571 verbatim, adapted to scoped Astro --- */
  .b-category {
    padding: var(--sp-6); /* sketch line 535 */
    min-height: calc(100vh - 120px);
  }
  .b-cat-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: end;
    gap: var(--sp-6);
    padding-bottom: var(--sp-5);
    /* Neutral hairline (was #333) — calmer, tied to the paper ink rather than a
       one-off grey. */
    border-bottom: 1px solid rgba(242, 235, 219, 0.14);
  }
  /* Raised pill (anti-vibecode): paper surface on the dark canvas with a lit top
     edge and soft drop shadow instead of a stroke. Horizontal padding 2x vertical. */
  .b-cat-back {
    display: inline-block;
    background: var(--paper);
    color: var(--ink);
    padding: 8px 16px;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: var(--fs-mono);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    align-self: end;
    justify-self: start;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      inset 0 -1px 0 rgba(10, 10, 10, 0.18),
      0 10px 24px -16px rgba(0, 0, 0, 0.6);
    transition: background 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
  }
  /* D-06 Touch-hover gate (Plan 05-07 Task 1). Back-pill hover color/bg only
     fires on devices with a real hover mechanism. */
  @media (hover: hover) and (pointer: fine) {
    .b-cat-back:hover {
      background: var(--accent);
      color: var(--paper);
    }
  }
  .b-cat-back:focus-visible {
    outline: 3px solid var(--paper);
    outline-offset: 3px;
  }
  .b-category h2 {
    font-family: var(--sans);
    font-weight: 800;
    font-size: var(--fs-cat);
    line-height: var(--lh-cat);
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: var(--paper);
    margin: 0;
  }
  .b-category h2 em {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    color: var(--accent);
    text-transform: none;
  }
  .b-cat-meta {
    font-family: var(--mono);
    font-size: var(--fs-mono);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--paper);
    opacity: 0.8;
    justify-self: end;
    align-self: end;
  }
  .b-cat-meta strong {
    color: var(--accent); /* flow discipline accent (was hard-coded lime; phase-exit palette swap) */
    font-weight: 600;
  }

  /* Coming-soon stub (empty discipline). Anti-vibecode neutral surface on the
     dark category canvas: one raised panel lighter than the bg, the discipline
     accent reserved for the single primary "ready work" link. No second hue, no
     side accent, soft diffuse shadow. */
  .b-coming {
    margin-top: var(--sp-8);
    max-width: 560px;
    background: rgba(242, 235, 219, 0.05);
    border-radius: 20px;
    padding: var(--sp-8);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 24px 60px -36px rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .b-coming-lead {
    font-family: var(--sans);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--paper);
    margin: 0;
  }
  .b-coming-blurb {
    font-family: var(--serif);
    font-size: var(--fs-body);
    line-height: var(--lh-bio);
    color: var(--paper);
    opacity: 0.78;
    margin: 0;
    max-width: 44ch;
  }
  .b-coming-ready {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin-top: var(--sp-4);
    padding-top: var(--sp-5);
    border-top: 1px solid rgba(242, 235, 219, 0.12);
  }
  .b-coming-ready-label {
    font-family: var(--mono);
    font-size: var(--fs-mono);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper);
    opacity: 0.6;
  }
  .b-coming-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  /* The single primary action: accent-filled, the one place the discipline accent
     becomes a fill. Horizontal padding is 2x the vertical (10/20). */
  .b-coming-link {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border-radius: 10px;
    background: var(--accent);
    color: var(--paper);
    font-family: var(--mono);
    font-size: var(--fs-mono);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 14px 30px -18px rgba(0, 0, 0, 0.6);
    transition: transform 0.2s ease, filter 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .b-coming-link:hover { transform: translateY(-1px); filter: brightness(1.08); }
  }
  .b-coming-link:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 3px;
  }

  /* Reduced-motion (D-13) */
  @media (prefers-reduced-motion: reduce) {
    .b-cat-back { transition: none; }
    .b-coming-link { transition: none; }
  }

  @media (max-width: 900px) {
    .b-category { padding: var(--sp-5); }
    .b-cat-head { grid-template-columns: 1fr; gap: var(--sp-2); align-items: start; }
    .b-cat-meta { justify-self: start; }
  }
</style>

---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import fs from 'node:fs/promises';
import path from 'node:path';
import type { Category } from '../../content/categories';
import { shortForm } from '../../lib/shortform';

type Piece = CollectionEntry<'pieces'>;
interface NeighbourRef {
  slug: string;
  category: Category;
  title: string;
}

export async function getStaticPaths() {
  const all = await getCollection('pieces', ({ data }) => data.draft !== true);

  // Group by category and sort each group by `data.order` ASC.
  // MUST match the gallery's sort key at src/pages/[category].astro:25 verbatim.
  // Pitfall P-1: drift between gallery sort and prev/next sort breaks recruiter UX.
  const byCategory: Record<Category, Piece[]> = {
    design: [], finance: [], personal: [], saas: [],
  };
  for (const p of all) {
    const cat = p.data.category as Category;
    byCategory[cat].push(p);
  }
  for (const cat of Object.keys(byCategory) as Category[]) {
    byCategory[cat].sort((a, b) => a.data.order - b.data.order);
  }

  const toRef = (p: Piece | null): NeighbourRef | null =>
    p ? { slug: p.id, category: p.data.category as Category, title: p.data.title } : null;

  return all.map((piece) => {
    const sibs = byCategory[piece.data.category as Category];
    const idx = sibs.findIndex((s) => s.id === piece.id);
    return {
      params: { category: piece.data.category, slug: piece.id },
      props: {
        piece,
        prev: toRef(idx > 0 ? sibs[idx - 1] : null),
        next: toRef(idx < sibs.length - 1 ? sibs[idx + 1] : null),
      },
    };
  });
}

interface Props {
  piece: CollectionEntry<'pieces'>;
  prev: NeighbourRef | null;
  next: NeighbourRef | null;
}
const { piece, prev, next } = Astro.props;
const { title, hero, context, role, outcome, category, pdfPaginate, fullPdf, year, deliverables, gallery } = piece.data;
const slug = piece.id;

// Read .cache.json sidecar at build time for dimensions (avoids CLS — Pitfall 1)
let thumbCache: { pages: Array<{ n: number; w: number; h: number; bytes?: number; file: string }> } | null = null;
try {
  const cachePath = path.join(process.cwd(), 'public', 'generated', 'pdf-thumbs', slug, '.cache.json');
  thumbCache = JSON.parse(await fs.readFile(cachePath, 'utf8'));
} catch { /* no thumbs for this piece — skip pagination */ }

// Preserve pdfPaginate array order (D-09: NO re-sort — Caleb may lead with the punchline).
// Use p.file from the cache (D-05: page 1 → cover.webp, others → page-{N}.webp); never compute the URL from p.n.
const paginatedPages = pdfPaginate && thumbCache
  ? (pdfPaginate
      .map((n) => thumbCache!.pages.find((p) => p.n === n))
      .filter(Boolean) as Array<{ n: number; w: number; h: number; file: string }>)
  : [];

// 2026-08-04: piece pages run greyscale (see the note in [category].astro).
// DISCIPLINE_ACCENT is still the splash's source of truth, just not used here.
const accent = 'var(--work-accent)';

// Split "Name - descriptor" titles the same way PieceCarousel.astro does:
// the name is the display heading, the descriptor becomes its own subheading.
const splitAt = title.indexOf(' - ');
const titleName = splitAt === -1 ? title : title.slice(0, splitAt);
const titleSub = splitAt === -1 ? null : title.slice(splitAt + 3);

// Short names for the top pager links ("← Remy" instead of the full title).
const shortName = (t: string) => {
  const i = t.indexOf(' - ');
  return i === -1 ? t : t.slice(0, i);
};

// Hero mosaic: instead of one over-scaled hero, show up to 4 pieces of media at
// once (hero + gallery shots + PDF pages) inside a viewport-height grid.
// Media consumed here is excluded from the gallery / paginated stacks below.
const galleryImgs = gallery ?? [];
const MOSAIC_MAX = 4;
const galleryUsed = Math.min(galleryImgs.length, MOSAIC_MAX - 1);
const pagesUsed = Math.min(paginatedPages.length, MOSAIC_MAX - 1 - galleryUsed);
const mosaicAssets = [hero, ...galleryImgs.slice(0, galleryUsed)];
const mosaicPages = paginatedPages.slice(0, pagesUsed);
const mosaicCount = mosaicAssets.length + mosaicPages.length;
const restGallery = galleryImgs.slice(galleryUsed);
const restPages = paginatedPages.slice(pagesUsed);

// UI-SPEC.md "Detail page copy" line 303 — back-pill label per discipline.
// 2026-05-18 (UAT): Title-cased to match the rest of the site's chrome — was lowercase.
const backLabel: Record<Category, string> = {
  design:    '← Graphic Design',
  finance:   '← Financial Models',
  personal:  '← Personal Projects',
  saas: '← SaaS',
};

// Tier 2 meta strip: discipline label mirrors backLabel minus the arrow.
const metaLabel: Record<Category, string> = {
  design:   'Graphic Design',
  finance:  'Financial Models',
  personal: 'Personal Projects',
  saas:     'SaaS',
};
---
<Base title={`${title} — Caleb Lim`} bg="ink" description={context}>
  <article class="detail" style={`--accent: ${accent}`}>
    <header class="detail-head">
      <div class="head-nav">
        <a href={`/${category}`} class="b-cat-back">{backLabel[category as Category]}</a>
        {(prev || next) && (
          <nav class="head-pager" aria-label="other pieces in this discipline">
            {prev && (
              <a class="head-pager-link" href={`/${prev.category}/${prev.slug}`} rel="prev">← {shortName(prev.title)}</a>
            )}
            {next && (
              <a class="head-pager-link" href={`/${next.category}/${next.slug}`} rel="next">{shortName(next.title)} →</a>
            )}
          </nav>
        )}
      </div>
      <h1>{titleName}</h1>
      {titleSub && <p class="detail-sub">{titleSub}</p>}
      <div class="meta-strip">
        <span class="meta-disc">{metaLabel[category as Category]}</span>
        {year && (<><span class="meta-dot">·</span><span class="meta-year">{year}</span></>)}
        {deliverables && deliverables.length > 0 && (
          <ul class="deliverables">
            {deliverables.map((d) => <li class="deliverable">{d}</li>)}
          </ul>
        )}
      </div>
    </header>

    {/* PIECE-01: hero media rendered via Astro's optimized image component, NEVER an iframe-PDF */}
    {/* Hero mosaic: up to 4 media cells in a viewport-height grid so more of the
        product is visible at once and nothing gets upscaled blurry. First cell is
        the LCP element (priority); the rest lazy-load. */}
    <div class="hero-mosaic" data-count={mosaicCount}>
      {mosaicAssets.map((img, i) => (
        <div class="mosaic-cell">
          <Image
            src={img}
            alt={i === 0 ? title : `${title} - image ${i + 1}`}
            priority={i === 0}
            loading={i === 0 ? 'eager' : 'lazy'}
            sizes="(max-width: 900px) 100vw, 640px"
          />
        </div>
      ))}
      {mosaicPages.map((p) => (
        <div class="mosaic-cell mosaic-page">
          <img
            src={`/generated/pdf-thumbs/${slug}/${p.file}`}
            width={p.w}
            height={p.h}
            alt={`${title} — page ${p.n}`}
            loading="lazy"
          />
        </div>
      ))}
    </div>

    {/* Tier 2: narrative body. Context as the lead (situation), Role as action. */}
    <section class="narrative">
      <div class="cro-block">
        <span class="label">Context</span>
        <p class="lead"><span class="sf-full">{context}</span><span class="sf-short">{shortForm(context)}</span></p>
      </div>
      <div class="cro-block">
        <span class="label">Role</span>
        <p><span class="sf-full">{role}</span><span class="sf-short">{shortForm(role)}</span></p>
      </div>
    </section>

    {/* Tier 2: Outcome lifted out of the equal stack into the page's payoff band. */}
    <section class="outcome-band">
      <span class="label outcome-label">Outcome</span>
      <p><span class="sf-full">{outcome}</span><span class="sf-short">{shortForm(outcome)}</span></p>
    </section>

    {/* Gallery: uploaded images, full-width stack, after the story, before PDF slides. */}
    {restGallery.length > 0 && (
      <section class="gallery">
        {restGallery.map((img, i) => (
          <Image
            src={img}
            alt={`${title} - image ${galleryUsed + i + 1}`}
            class="gallery-img"
            loading="lazy"
            sizes="(max-width: 960px) 100vw, 960px"
          />
        ))}
      </section>
    )}

    {/* PIECE-04: paginated <img> sequence (plain HTML img tag, NOT Astro's optimized image component — Pitfall 1: that component cannot resolve public/ paths). */}
    {/* Width/height sourced from .cache.json for CLS prevention. Render order = pdfPaginate order (D-09). */}
    {restPages.length > 0 && (
      <section class="paginated-pages">
        {restPages.map((p) => (
          <img
            src={`/generated/pdf-thumbs/${slug}/${p.file}`}
            width={p.w}
            height={p.h}
            alt={`${title} — page ${p.n}`}
            loading="lazy"
          />
        ))}
      </section>
    )}

    {/* PIECE-06: optional Open full PDF link — surfaces only on pieces with fullPdf set (D-17). */}
    {fullPdf && (
      <p class="full-pdf-link">
        <a href={fullPdf} download>Open full PDF →</a>
      </p>
    )}

  </article>
</Base>

<style>
  .detail {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--sp-6);
  }
  /* Text runs the same full width as the header pills and media (2026-08-06,
     owner call: no mid-page cut-off; the column ends where the pill row ends). */
  .head-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .head-pager {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }
  /* Same raised-pill treatment as the back pill, quieter surface. */
  .head-pager-link {
    display: inline-block;
    background: rgba(242, 235, 219, 0.06);
    color: var(--paper);
    padding: 8px 16px;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: var(--fs-mono);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 10px 24px -16px rgba(0, 0, 0, 0.6);
    transition: background 0.2s ease, color 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .head-pager-link:hover {
      background: var(--paper);
      color: var(--ink);
    }
  }
  .head-pager-link:focus-visible {
    outline: 3px solid var(--paper);
    outline-offset: 3px;
  }
  .detail-head {
    border-top: 4px solid var(--accent);
    padding-top: var(--sp-4);
    margin-bottom: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  /* Raised pill (anti-vibecode): paper surface on the dark canvas with a lit top
     edge and soft drop shadow instead of a stroke. Horizontal padding 2x vertical. */
  .b-cat-back {
    display: inline-block;
    background: var(--paper);
    color: var(--ink);
    padding: 8px 16px;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: var(--fs-mono);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    align-self: flex-start;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      inset 0 -1px 0 rgba(10, 10, 10, 0.18),
      0 10px 24px -16px rgba(0, 0, 0, 0.6);
    transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
    text-decoration: none;
  }
  /* D-06 Touch-hover gate (Plan 05-07 Task 1). Back-pill hover color/bg only on
     devices with a real hover mechanism. */
  @media (hover: hover) and (pointer: fine) {
    .b-cat-back:hover {
      background: var(--accent);
      color: var(--paper);
    }
  }
  .b-cat-back:focus-visible {
    outline: 3px solid var(--paper);
    outline-offset: 3px;
  }
  /* Detail titles get their own scale, well below the room-header --fs-cat
     (which peaks at 130px and overwhelms multi-word case-study names). */
  .detail h1 {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    color: var(--paper);
    margin: 0;
    max-width: 20ch;
  }
  /* Subheading: the descriptor half of "Name - descriptor" titles. Sentence
     case, quieter weight, sits tight under the display name. */
  .detail-sub {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(18px, 2.2vw, 26px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--paper);
    opacity: 0.85;
    margin: calc(var(--sp-2) - var(--sp-4)) 0 0;
    max-width: 44ch;
  }
  .meta-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
  }
  .meta-disc, .meta-year, .meta-dot {
    font-family: var(--mono);
    font-size: var(--fs-mono);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper);
    opacity: 0.6;
  }
  .deliverables {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  /* Raised pills: no stroke, lifted off ink canvas, soft shadow, 2:1 padding. */
  .deliverable {
    background: rgba(242, 235, 219, 0.06);
    color: var(--paper);
    padding: var(--sp-1) var(--sp-2);
    border-radius: 999px;
    font-family: var(--mono);
    font-size: var(--fs-mono);
    font-weight: 600;
    letter-spacing: 0.08em;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 6px 14px -10px rgba(0, 0, 0, 0.6);
  }
  /* Hero mosaic: fills the viewport width and caps at ~68vh so the media band
     and the start of the story share the first screen. Every cell CONTAINS its
     media whole (2026-08-06, owner call: no cropped screenshots anywhere) on
     the glass work surface; the cell ratios only shape the grid. */
  .hero-mosaic {
    display: grid;
    gap: var(--sp-3);
    margin-bottom: var(--sp-8);
  }
  .mosaic-cell {
    overflow: hidden;
    border-radius: 8px;
    background: var(--glass-fill);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    box-shadow:
      inset 0 1px 0 var(--glass-lit),
      inset 0 0 0 1px var(--glass-rim),
      var(--glass-shadow);
  }
  .mosaic-cell img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    padding: var(--sp-2);
    display: block;
  }
  .hero-mosaic[data-count="1"] {
    grid-template-columns: 1fr;
  }
  .hero-mosaic[data-count="1"] .mosaic-cell {
    aspect-ratio: 16 / 9;
    max-height: 68vh;
  }
  .hero-mosaic[data-count="2"] {
    grid-template-columns: 1fr 1fr;
  }
  .hero-mosaic[data-count="2"] .mosaic-cell {
    aspect-ratio: 4 / 3;
    max-height: 68vh;
  }
  .hero-mosaic[data-count="3"],
  .hero-mosaic[data-count="4"] {
    height: min(68vh, 640px);
  }
  .hero-mosaic[data-count="3"] {
    grid-template-columns: 3fr 2fr;
    grid-template-rows: 1fr 1fr;
  }
  .hero-mosaic[data-count="3"] .mosaic-cell:first-child {
    grid-row: span 2;
  }
  .hero-mosaic[data-count="4"] {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }
  .narrative {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    margin-bottom: var(--sp-8);
  }
  .cro-block {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .label {
    font-family: var(--mono);
    font-size: var(--fs-mono);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--paper);
    opacity: 0.6;
  }
  .narrative p {
    font-family: var(--serif);
    font-size: var(--fs-body);
    line-height: var(--lh-bio);
    color: var(--paper);
    margin: 0;
  }
  /* Context reads at the same body size as Role/Outcome — one consistent
     text scale across the whole case study. */
  .narrative p.lead {
    font-size: var(--fs-body);
    line-height: var(--lh-bio);
  }

  /* Outcome payoff band: raised surface on dark canvas (lighter than bg), soft
     diffuse shadow, lit top edge. The page's payoff. */
  .outcome-band {
    background: var(--glass-fill);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border-radius: 12px;
    padding: var(--sp-6);
    margin-bottom: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    box-shadow:
      inset 0 1px 0 var(--glass-lit),
      inset 0 0 0 1px var(--glass-rim),
      var(--glass-shadow);
  }
  .outcome-band .outcome-label {
    color: var(--accent);
    opacity: 1;
  }
  .outcome-band p {
    font-family: var(--serif);
    font-size: var(--fs-body);
    line-height: var(--lh-bio);
    color: var(--paper);
    margin: 0;
  }
  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    margin-bottom: var(--sp-8);
  }
  .gallery-img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .paginated-pages {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    margin-bottom: var(--sp-8);
  }
  .paginated-pages img {
    width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .full-pdf-link {
    margin: var(--sp-6) 0;
  }
  .full-pdf-link a {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--fs-body); /* was 16px; migrated to --fs-body (15.5px) per 05-TOKEN-MAP */
    color: var(--paper);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  /* D-06 Touch-hover gate (Plan 05-07 Task 1). Color-only hover gated; the
     :focus-visible outline rule stays outside. */
  @media (hover: hover) and (pointer: fine) {
    .full-pdf-link a:hover {
      color: var(--accent);
    }
  }
  .full-pdf-link a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .head-pager-link { transition: none; }
  }

  /* Case-study titles run long ("Remy - photo-first calorie tracker"); keep
     them compact on phones. */
  @media (max-width: 700px) {
    .detail h1 { font-size: clamp(26px, 7.5vw, 34px); }
  }
  @media (max-width: 900px) {
    .detail { padding: var(--sp-5); }
    /* Mosaic collapses to a 2-up grid with natural rows; single image stays full. */
    .hero-mosaic[data-count="3"],
    .hero-mosaic[data-count="4"] {
      height: auto;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: none;
    }
    .hero-mosaic[data-count="3"] .mosaic-cell,
    .hero-mosaic[data-count="4"] .mosaic-cell {
      aspect-ratio: 4 / 5;
    }
    .hero-mosaic[data-count="3"] .mosaic-cell:first-child {
      grid-row: auto;
      grid-column: span 2;
      aspect-ratio: 16 / 10;
    }
    .hero-mosaic[data-count="2"] {
      grid-template-columns: 1fr;
    }
    .hero-mosaic[data-count="2"] .mosaic-cell {
      aspect-ratio: 16 / 10;
    }
    .outcome-band { padding: var(--sp-5); }
    .meta-strip { gap: var(--sp-2); }
  }
</style>

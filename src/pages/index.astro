         visible bar would float low under the bottom padding. */
      scrollbar-width: none;
    }
    .b-cards::-webkit-scrollbar { display: none; }
    .b-cards > :global(.b-card) {
      flex: 0 0 80%;
      scroll-snap-align: start;
    }
  }
</style>

{/* Global: during the 5th brand click, lift the topbar above the intro overlay

    0%   { transform: translate(-50%, -50%) translate(0, 0) rotate(0deg) scale(0.3); opacity: 1; }
    15%  { opacity: 1; }
    100% { transform: translate(-50%, -50%) translate(var(--tx), var(--ty)) rotate(var(--rot, 360deg)) scale(1); opacity: 0; }

     acid, so silhouette goes back to ink-on-turmeric to match k2/k3's ink-on-light
     decoration approach). Anchored to bottom-right with a slight bleed so it
     crops naturally to the rounded card edge. */
  .b-bio-mark {
    display: none; /* 2026-06-26: dropped the silhouette watermark in the horizontal band */
    position: absolute;
    bottom: 8px;
    left: 8px;
    color: var(--paper);
    opacity: 0.35;
    line-height: 0;
    pointer-events: none;
    display: block;
  }
  .b-bio-mark :global(svg) {
    width: 120px;
    height: 120px;
  }
  /* QUIET DIVIDER (was the question bar). Lower-contrast hairlines than before. */
  .b-question {
    border-top: 1px solid rgba(10, 10, 10, 0.10);
    border-bottom: 1px solid rgba(10, 10, 10, 0.10);
    padding: 6px 0;
  }
  /* Plan 05-09 Task 2 deviation: the post-Task-3 re-audit caught --terracotta bg
     (#82785d) + --paper fg (#f2ebdb) at 3.68:1 — under WCAG AA 4.5:1 for 13px bold
     text. Swap to --ink bg + --paper fg (>=15:1) — black-pill tag stays in the
     magazine-maximalist vocabulary and is a familiar pattern alongside the existing
     ABOUT / KEEP READING tags below. The 13px bold uppercase silhouette is preserved. */
  .b-question .marker {
    background: var(--ink);
    color: var(--paper);
    font-family: var(--sans);
    font-weight: 800;

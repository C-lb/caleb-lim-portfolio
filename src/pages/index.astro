  /* D-06 Touch-hover gate (Plan 05-07 Task 1). Bio-card 3D tilt + glass overlay
     + entrance-shake pause only fire on devices with a real hover mechanism.
     On touch, the entrance shimmer (added in Task 2) is the substitute
     micro-interaction; first tap navigates to /about. */
  @media (hover: hover) and (pointer: fine) {
    .b-bio:hover {
      /* 2026-06-26: clean straight lift (no tilt) to match the discipline cards. */
      transform: translateY(-4px);

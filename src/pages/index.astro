---
import Base from '../layouts/Base.astro';
import DisciplineCard from '../components/DisciplineCard.astro';
import { CATEGORIES, type Category } from '../content/categories';
import { DISCIPLINE_ACCENT, DISCIPLINE_K } from '../styles/disciplines';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import PieceCarousel from '../components/PieceCarousel.astro';
import portrait1 from '../assets/portrait.jpg';
import portrait2 from '../assets/portrait2.JPG';
import portrait3 from '../assets/portrait3.jpg';
import portrait4 from '../assets/portrait4.jpg';
import portrait5 from '../assets/portrait5.jpeg';
const portraits = [portrait1, portrait2, portrait3, portrait4, portrait5];
// Easter-egg gift assets — cycled (with the chiptune + pop) on every brand click
// past 22. portrait5 leads since it's the first reveal.
const eggAssets = [portrait5, portrait1, portrait2, portrait3, portrait4];
// Optional per-slide caption. Null = no caption.
// 2026-05-18 (UAT): captions on 2/3/4 — portraits 1 and 5 caption-less.
const portraitCaptions: (string | null)[] = [null, 'graphic design', 'event hosting', 'social impact', null];

// SPLASH-04 / D-07: drop cards for empty disciplines. Build-time count of
// non-draft pieces per category. Personal often empty at launch.
const allPieces = await getCollection('pieces', ({ data }) => data.draft !== true);
const countByCategory: Record<Category, number> = {
  design: 0, finance: 0, personal: 0, saas: 0,
};
for (const piece of allPieces) {
  countByCategory[piece.data.category]++;
}
// Carousel order: group by canonical discipline order, then within-room order.
// `data.order` restarts at 1 per category, so it is not a global rank on its own.
const sortedPieces = [...allPieces].sort((a, b) =>
  (CATEGORIES.indexOf(a.data.category) - CATEGORIES.indexOf(b.data.category))
  || (a.data.order - b.data.order),
);
// 2026-05-18 (UAT-driven): user reversed Phase 3's SPLASH-04 drop-empty-cards
// rule. Splash now shows all 4 disciplines always — populated ones link to /{cat},
// empty ones render as non-clickable placeholders with a "coming soon" cue. The
// thesis (4 disciplines, cross-functional) reads clearly even at launch when only
// 2 are populated.
// Splash render order is intentionally distinct from CATEGORIES (which is the
// canonical content/route order). 2026-05-18 (UAT): swapped marketing and
// personal so the populated marketing card sits next to the populated design
// card in row 1's pair-with-placeholder rhythm.
const allCategoriesOnSplash: readonly Category[] = ['design', 'finance', 'saas', 'personal'];
// 2026-06-26: the role labels (analyst / brand strategist / designer / marketer)
// under CALEB LIM were removed at the owner's request, along with their
// scroll-to-card interaction.
// N-card grid template (UI-SPEC.md lines 446-451). With placeholder cards landed
// 2026-05-18 the splash always shows 4 cards, so the 4-card template is the only
// one that fires in practice — the other entries kept for forward-compat with
// future scope changes (e.g., a 5th discipline).
// 2026-05-18 (UAT): 4-card layout flipped from a single row (1.2fr 0.85fr 1fr 1fr)
// to a 2x2 matrix — two columns, two rows. Reads as a balanced grid rather than
// a wide horizontal sweep, and pairs each populated card next to its placeholder
// counterpart at desktop widths.
// 2026-06-26 (redesign): cards deploy on a real 12-column grid — four cards span
// 3 columns each, a single scannable row on desktop (collapses to 2 then 1 col via
// the media queries below). The 2x2 matrix is retired.
const gridTemplate = {
  4: 'repeat(12, 1fr)',
  3: 'repeat(12, 1fr)',
  2: '1fr 1fr',
  1: '1fr',
}[allCategoriesOnSplash.length] ?? 'repeat(12, 1fr)';
// DISCIPLINE_ACCENT is imported to keep the splash's k→accent contract co-located
// even though the card component owns its own CSS; suppress unused-import lint.
void DISCIPLINE_ACCENT;
---
<Base title="Caleb Lim — Portfolio" bg="paper" description="Caleb Lim. Pick the room that matches the role you are hiring for: brand and design, financial models, product, or side projects.">
  {/* First-visit intro. White blurred overlay; the line lifts in saying "What's
      up?", backspaces, types "Welcome.", then the overlay lifts away to reveal the
      page. Driven by the script below; once per session; skipped under
      reduced-motion. Present at first paint so the homepage never flashes. */}
  <div class="intro" data-intro aria-hidden="true">
    <div class="intro-stack">
      <p class="intro-line">
        <span class="intro-text" data-intro-text></span><span class="intro-caret" data-intro-caret aria-hidden="true"></span>
      </p>
      {/* Phone-only "tap to enter" gate (shown by JS in .enter-mode). The tap is the
          user gesture that unlocks WebAudio, so the intro that follows has sound.
          On tap it pops to "Success!" and bursts pastel confetti + stars. */}
      <button class="intro-enter" data-intro-enter type="button" aria-label="Tap to enter the site with sound">
        <span class="ie-label" data-ie-label>Tap to enter</span>
      </button>
      {/* Easter-egg photo — src is set lazily in JS (cycling the list below) so it
          never loads for normal visitors. */}
      <img class="intro-egg" data-intro-egg data-egg-srcs={JSON.stringify(eggAssets.map((a) => a.src))} alt="Caleb Lim" decoding="async" />
    </div>
    {/* At the 5th brand click — points up to the top-right nav buttons. */}
    <div class="intro-arrow" data-intro-arrow aria-hidden="true">
      <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 104 C 30 60, 60 36, 100 24" />
        <path d="M74 22 L 104 20 L 96 50" />
      </svg>
    </div>
  </div>
  <section class="b-splash">
    <div class="b-hero">
      <div class="b-portrait" data-portrait-carousel data-bp-interval="3000">
        <div class="bp-track" data-bp-track>
          {portraits.map((src, i) => (
            <div class={`bp-slide${i === 0 ? ' is-active' : ''}`} data-bp-slide>
              <Image
                src={src}
                alt={`Portrait of Caleb Lim, photo ${i + 1}`}
                widths={[280, 560]}
                sizes="(max-width: 900px) 100vw, 280px"
                priority={i === 0}
              />
              {portraitCaptions[i] && <span class="bp-caption">{portraitCaptions[i]}</span>}
            </div>
          ))}
        </div>
        <button class="bp-arrow bp-arrow-prev" data-bp-prev type="button" aria-label="Previous photo">‹</button>
        <button class="bp-arrow bp-arrow-next" data-bp-next type="button" aria-label="Next photo">›</button>
        <div class="bp-dots" data-bp-dots role="group" aria-label="Portrait photo selector">
          {portraits.map((_, i) => (
            <button
              class={`bp-dot${i === 0 ? ' is-active' : ''}`}
              data-bp-dot={i}
              type="button"
              aria-label={`Photo ${i + 1}`}
              {...(i === 0 ? { 'aria-current': 'true' } : {})}
            ></button>
          ))}
        </div>
        <div class="bp-glass" aria-hidden="true"></div>
      </div>
      <div class="b-name">
        <p class="b-greeting" aria-live="polite"><span class="greet" data-greet></span><span class="greet-caret" aria-hidden="true"></span></p>
        <h1><span class="im">I'm</span> CALEB<br /><span class="lim">LIM</span></h1>
      </div>
    </div>

    <a href="/about" class="b-bio">
        <span class="bb-warp" aria-hidden="true"></span>
        <span class="bb-tint" aria-hidden="true"></span>
        <span class="bb-edge" aria-hidden="true"></span>
        <div class="b-bio-head">
          <h2>About Me</h2>
        </div>
        <p>Four lanes: brand and design, financial models, product, and side projects. Pick the room that matches the role you are hiring for. If something fits, come say hi.</p>
      </a>

    <div id="cards" class="b-cards" style={`grid-template-columns: ${gridTemplate}`}>
      {allCategoriesOnSplash.map((cat, i) => (
        <DisciplineCard
          category={cat}
          k={DISCIPLINE_K[cat]}
          index={(i + 1) as 1 | 2 | 3 | 4}
          isEmpty={countByCategory[cat] === 0}
        />
      ))}
    </div>

    <PieceCarousel pieces={sortedPieces} accent="var(--terracotta)" theme="light" label="A glimpse of my work" />
  </section>
</Base>

<style>
  /* ---------- First-visit intro overlay ---------- */
  .intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    padding: var(--sp-6);
    background: rgba(255, 255, 255, 0.98);
    -webkit-backdrop-filter: blur(16px) saturate(1.05);
    backdrop-filter: blur(16px) saturate(1.05);
    /* The exit lift — also blurs and smears as it leaves. */
    transition: transform 780ms cubic-bezier(0.76, 0, 0.18, 1),
                opacity 780ms ease,
                filter 780ms ease,
                -webkit-backdrop-filter 780ms ease,
                backdrop-filter 780ms ease;
    will-change: transform, filter;
  }
  .intro.is-exiting {
    transform: translateY(-100%);
    opacity: 0;
    filter: blur(12px);
    -webkit-backdrop-filter: blur(36px) saturate(1.05);
    backdrop-filter: blur(36px) saturate(1.05);
  }
  .intro.is-done { display: none; }

  .intro-line {
    margin: 0;
    display: block;
    text-align: center;
    /* Wrap before the border instead of overflowing: cap the line width so long
       messages (the easter-egg lines especially) break onto new lines near the edge
       rather than running off-screen. */
    max-width: min(92vw, 820px);
    line-height: 1.12;
    /* font-size lives here so the caret's em-based height scales with the text */
    font-size: clamp(40px, 8vw, 92px);
    /* Entrance lift lives on the line (was on the text + caret) so the text can be a
       plain inline run that wraps naturally with the caret trailing the last char. */
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 640ms ease, transform 640ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .intro-text {
    font-family: var(--sans);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--ink);
    /* white-space defaults to normal so long lines wrap instead of overflowing.
       Greedy (not balanced) wrapping keeps line breaks stable while typing. */
  }
  .intro-caret {
    display: inline-block;
    width: 0.06em;
    height: 0.72em; /* cap height — matches the letters */
    margin-left: 0.04em;
    vertical-align: baseline; /* sits on the text baseline like a cursor; follows wraps */
    background: var(--ink);
    border-radius: 1px;
  }
  .intro.is-lifted .intro-line {
    opacity: 1;
    transform: translateY(0);
  }
  /* Steady while typing/deleting; blinks during the holds (class toggled in JS). */
  .intro-caret.is-blinking { animation: intro-blink 1s step-end infinite; }
  @keyframes intro-blink {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0; }
  }

  /* Line + (hidden) easter-egg photo, stacked and centred. */
  .intro-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(22px, 4vw, 40px);
  }
  .intro-egg {
    display: none;
    width: clamp(170px, 34vw, 280px);
    height: auto;
    border-radius: 20px;
    box-shadow: 0 30px 64px -28px rgba(10, 10, 10, 0.55);
    opacity: 0;
    transform: scale(0.6);
  }
  /* Pop the photo in with a little overshoot when the egg fires. */
  .intro.show-egg .intro-egg {
    display: block;
    animation: egg-pop 620ms cubic-bezier(0.2, 1.3, 0.4, 1) forwards;
  }
  @keyframes egg-pop {
    0%   { opacity: 0; transform: scale(0.5) rotate(-6deg); }
    60%  { opacity: 1; transform: scale(1.06) rotate(2deg); }
    100% { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  /* "Tap to enter" button — phone-only first-visit gate (the single primary action
     on the overlay, so the accent fill is allowed). Hidden until JS adds .enter-mode,
     which also hides the typing line so only the button shows, centred. */
  .intro-enter { display: none; }
  .intro.enter-mode .intro-line { display: none; }
  .intro.enter-mode .intro-enter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45em;
    appearance: none;
    -webkit-appearance: none;
    border: none;
    cursor: pointer;
    font-family: var(--sans);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.01em;
    color: var(--paper);
    background: var(--terracotta);
    padding: 16px 32px; /* 2:1 */
    border-radius: 999px;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.32),
      0 14px 30px -14px rgba(10, 10, 10, 0.5);
    animation: enter-breathe 2.4s ease-in-out infinite;
    transition: transform 160ms cubic-bezier(0.34, 1.56, 0.64, 1),
                background 220ms ease, box-shadow 220ms ease;
  }
  .intro.enter-mode .intro-enter:active { transform: scale(0.94); }
  .intro.enter-mode .intro-enter:focus-visible { outline: 3px solid var(--ink); outline-offset: 4px; }
  /* Success: stop breathing, flash success green, pop once. */
  .intro.enter-mode .intro-enter.is-success {
    background: #46c46a;
    animation: enter-pop 460ms cubic-bezier(0.2, 1.3, 0.4, 1);
  }
  @keyframes enter-breathe {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.045); }
  }
  @keyframes enter-pop {
    0%   { transform: scale(0.94); }
    45%  { transform: scale(1.1); }
    100% { transform: scale(1); }
  }

  /* "Click my other buttons" arrow — pinned top-right, pointing up at the nav. */
  .intro-arrow {
    position: absolute;
    top: clamp(58px, 8vh, 92px);
    right: clamp(26px, 6vw, 78px);
    width: clamp(64px, 11vw, 104px);
    color: var(--ink);
    opacity: 0;
    pointer-events: none;
  }
  .intro-arrow svg { width: 100%; height: auto; display: block; }
  .intro.show-arrow .intro-arrow {
    animation: arrow-in 360ms ease forwards, arrow-bob 1.1s ease-in-out 360ms infinite;
  }
  @keyframes arrow-in {
    from { opacity: 0; transform: translateY(8px) scale(0.9); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes arrow-bob {
    0%, 100% { transform: translate(0, 0); }
    50%      { transform: translate(6px, -6px); }
  }

  /* Reduced motion: no lift, no typing — the script removes the overlay at once. */
  @media (prefers-reduced-motion: reduce) {
    .intro,
    .intro-line { transition: none; }
    .intro-caret.is-blinking { animation: none; }
    .intro.show-egg .intro-egg { animation: none; opacity: 1; transform: none; }
    .intro.show-arrow .intro-arrow { animation: none; opacity: 1; transform: none; }
  }

  /* --- Sketch lines 283-530 verbatim, adapted to scoped Astro --- */
  .b-splash {
    min-height: calc(100vh - 120px); /* leave room for Base topbar + footer */
    /* 2026-06-26 (redesign): more breathing room + a centred max-width so the
       layout doesn't sprawl edge-to-edge on wide screens. */
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(20px, 3.5vw, 40px);
    display: grid;
    /* 2026-06-26: three stacked bands — header (portrait + name), then the about-me
       card, then the discipline picker. */
    grid-template-rows: auto auto auto;
    align-content: space-between;
    gap: clamp(24px, 3.4vw, 44px);
  }

  /* HEADER BAND: portrait (3) | name (9). */
  .b-hero {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(20px, 3vw, 44px);
    align-items: center;
    min-height: 0;
  }
  .b-hero > .b-portrait { grid-column: span 3; }
  .b-hero > .b-name     { grid-column: span 9; }
  .b-portrait {
    background: var(--ink);
    border-radius: 18px; /* matches the glass cards */
    overflow: hidden;
    position: relative;
    aspect-ratio: 4/5; /* keep portrait shape; carousel slides fill this box */
    /* Slightly smaller now that the about-me card sits below the header. */
    width: 100%;
    max-width: 260px;
    justify-self: start;
    box-shadow: 0 22px 48px -26px rgba(10, 10, 10, 0.7);
  }
  /* Liquid-glass frame: a lit bevel rim over the photo so the portrait reads as a
     card set in glass (the photo stays fully visible; this is the .edge layer of the
     glass recipe). pointer-events:none so the carousel arrows/dots stay clickable. */
  .b-portrait .bp-glass {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    border-radius: inherit;
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow:
      inset 1.5px 1.5px 1px rgba(255, 255, 255, 0.45),
      inset -1px -1px 1px rgba(255, 255, 255, 0.18),
      inset 0 0 34px rgba(255, 255, 255, 0.06);
  }
  /* 2026-05-18 (UAT v2): slides are absolutely stacked; each transitions
     independently. JS pre-positions the incoming slide off-screen on the
     chosen axis, then animates it to (0,0); the outgoing slide exits to
     the opposite edge. Lets auto-advance pick random directions while
     keeping click/wrap motion deterministic. */
  .b-portrait .bp-track {
    position: absolute;
    inset: 0;
  }
  .b-portrait .bp-slide {
    position: absolute;
    inset: 0;
    background: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: var(--sp-2);
    /* Each slide carries the same corner radius as the outer .b-portrait frame so
       the photo's curved edge reads even during the slide-in (when it crosses the
       container midline, the curve preserves the card-shape silhouette). */
    border-radius: inherit;
    overflow: hidden;
    opacity: 0;
    /* Only transform animates — opacity is binary (idle slides invisible, in-flight
       slides fully opaque). Keeping both slides at opacity 1 during the swap means
       they tile the frame edge-to-edge and the dark .b-portrait backdrop never
       flashes through. */
    transition: transform 650ms cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }
  .b-portrait .bp-slide.is-active,
  .b-portrait .bp-slide.is-leaving {
    opacity: 1;
  }
  .b-portrait .bp-slide.is-active  { z-index: 2; }
  .b-portrait .bp-slide.is-leaving { z-index: 1; }
  @media (prefers-reduced-motion: reduce) {
    .b-portrait .bp-slide { transition: none; }
  }
  .b-portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }
  /* Per-slide caption overlay. Mono, white, anchored to bottom-left. A soft
     bottom-gradient sits behind the text so it stays legible against any photo. */
  .b-portrait .bp-caption {
    position: absolute;
    left: 14px;
    bottom: 52px; /* clears the dot pill with room to breathe */
    color: var(--paper);
    font-family: var(--mono);
    font-size: var(--fs-mono); /* was 11px; exact match per 05-TOKEN-MAP */
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6); /* legibility over varied photo backgrounds */
    z-index: 1;
    line-height: 1;
  }
  .b-portrait .bp-slide::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 80px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.45), transparent);
    pointer-events: none;
    opacity: 0;
    transition: opacity 250ms ease;
  }
  /* Only show the bottom gradient on slides that actually carry a caption. */
  .b-portrait .bp-slide:has(.bp-caption)::after {
    opacity: 1;
  }
  /* Wireframe slides — dashed-border placeholders for future portraits. Mirrors the
     /about page wireframe pattern (PHOTO · 0X + hint) so the visual language is consistent. */
  .b-portrait .bp-wireframe {
    background: rgba(15, 13, 12, 0.92);
    color: var(--paper);
    border: 2px dashed var(--terracotta);
    border-radius: 6px;
    inset: 6px; /* small inset so the dashed border reads inside the rounded outer frame */
  }
  .b-portrait .bp-tag {
    font-family: var(--mono);
    font-size: var(--fs-mono); /* was 11px; exact match per 05-TOKEN-MAP */
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  .b-portrait .bp-hint {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: var(--fs-ttl); /* was 18px; migrated to --fs-ttl (22px) per 05-TOKEN-MAP — nearest existing step */
    opacity: 0.85;
  }
  /* Hover-revealed prev/next arrows. Hidden by default; shown when the carousel
     is hovered or any of its controls receives keyboard focus. */
  .b-portrait .bp-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    /* Anti-vibecode glass control: translucent dark fill, lit rim, soft shadow. */
    background: rgba(20, 18, 16, 0.42);
    backdrop-filter: blur(6px) saturate(1.2);
    -webkit-backdrop-filter: blur(6px) saturate(1.2);
    color: var(--paper);
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.30),
      0 8px 18px -8px rgba(0, 0, 0, 0.55);
    cursor: pointer;
    opacity: 0;
    transition: opacity 180ms ease, background-color 180ms ease, transform 180ms ease;
    font-size: var(--fs-ttl); /* was 22px; exact match per 05-TOKEN-MAP */
    line-height: 1;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }
  .b-portrait:hover .bp-arrow,
  .b-portrait:focus-within .bp-arrow { opacity: 1; }
  .b-portrait .bp-arrow:hover { background: rgba(20, 18, 16, 0.62); transform: translateY(-50%) scale(1.08); }
  .b-portrait .bp-arrow:focus-visible { outline: 2px solid var(--paper); outline-offset: 2px; }
  .b-portrait .bp-arrow-prev { left: 8px; }
  .b-portrait .bp-arrow-next { right: 8px; }
  /* Instagram-style dot indicators at the bottom. The active dot is larger and
     fully opaque paper; inactive dots are semi-transparent paper. */
  .b-portrait .bp-dots {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    z-index: 2;
    /* Anti-vibecode glass pill so the dots read over any photo. */
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(20, 18, 16, 0.38);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }
  /* Tap target: 24×24 button shell (WCAG 2.5.5 / Lighthouse target-size). Visible
     8×8 dot rendered via ::before pseudo so the surface remains identical but the
     hit area doubles. Active state animates the pseudo, not the button. */
  .b-portrait .bp-dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .b-portrait .bp-dot::before {
    content: '';
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(242, 235, 219, 0.45);
    transition: background-color 180ms ease, transform 180ms ease;
  }
  .b-portrait .bp-dot.is-active::before {
    background: var(--paper);
    transform: scale(1.25);
  }
  .b-portrait .bp-dot:focus-visible { outline: 2px solid var(--paper); outline-offset: 2px; }

  .b-name {

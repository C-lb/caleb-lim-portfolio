  .b-question .arrow {
    color: var(--umber); /* warm umber splash accent (decoupled from the magenta graphic-design token) */
    font-family: var(--sans);
    font-size: var(--fs-h3); /* was 32px; migrated to --fs-h3 (26px) per 05-TOKEN-MAP — 1 use, nearest existing step (6px shrink) */
    font-weight: 700;
    line-height: 1;

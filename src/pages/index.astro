</style>

<script>
  // First-visit intro overlay. Sequence: lift in "What's up?", backspace it,
  // type "Welcome.", then lift the whole overlay away to reveal the homepage.
  // Runs once per session; reduced-motion (or a thrown error) reveals at once.
  (() => {
    const intro = document.querySelector<HTMLElement>('[data-intro]');
    if (!intro) return;
    const textEl = intro.querySelector<HTMLElement>('[data-intro-text]');
    const caret = intro.querySelector<HTMLElement>('[data-intro-caret]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const seen = sessionStorage.getItem('introSeen') === '1';

    // Broadcast once the intro is finished (or skipped) so the card glimmer and
    // the cycling greeting can hold off until the page is fully revealed.
    const signalDone = () => {
      if ((window as any).__introDone) return;
      (window as any).__introDone = true;
      document.dispatchEvent(new Event('intro:done'));
    };

    const reveal = () => {
      intro.classList.add('is-done');
      document.documentElement.style.overflow = '';
      try { sessionStorage.setItem('introSeen', '1'); } catch {}
      signalDone();
    };

    // Missing markup → nothing to animate. Otherwise keep going: the helpers below
    // stay defined even on repeat visits / reduced-motion so the brand-click replay
    // still works; only the first-visit auto-run is gated (see the dispatch block).
    if (!textEl || !caret) { reveal(); return; }

    // --- Intro sound effects. Synthesized with Web Audio (no asset files): a soft
    // key-click per typed character, a filtered-noise whoosh on each lift. Volume
    // is deliberately low. Best-effort under browser autoplay rules — the context
    // only produces sound once it's running, which a prior gesture grants; we also
    // try to resume it on the first interaction so repeat plays are reliable. ---
    let actx: AudioContext | null = null;
    const AC = (window.AudioContext || (window as any).webkitAudioContext);
    const getCtx = () => {
      if (!AC) return null;
      if (!actx) { try { actx = new AC(); } catch { return null; } }
      if (actx && actx.state === 'suspended') actx.resume().catch(() => {});
      return actx;
    };
    // Unlock + warm the audio context on the first user interaction. iOS Safari
    // only truly unlocks WebAudio when a buffer is started inside a gesture, so play
    // a 1-sample silent buffer once. Capture phase, all gesture types; keep resuming
    // on later gestures in case the context re-suspends (e.g. tab backgrounded).
    let audioUnlocked = false;
    const unlockAudio = () => {
      const ctx = getCtx();            // creates + resumes (best-effort)
      if (!ctx || audioUnlocked) return;
      try {
        const s = ctx.createBufferSource();
        s.buffer = ctx.createBuffer(1, 1, ctx.sampleRate);
        s.connect(ctx.destination);
        s.start(0);
        audioUnlocked = true;
      } catch {}
    };
    ['pointerdown', 'touchstart', 'keydown', 'click'].forEach((ev) =>
      window.addEventListener(ev, unlockAudio, { capture: true, passive: true }));

    let noiseBuf: AudioBuffer | null = null;
    const getNoise = (ctx: AudioContext) => {
      if (noiseBuf) return noiseBuf;
      noiseBuf = ctx.createBuffer(1, ctx.sampleRate, ctx.sampleRate);
      const d = noiseBuf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
      return noiseBuf;
    };
    // A "creamy" tactile keypress: a rounded low thock for body + a short ceramic
    // tap transient on top, run through a gentle lowpass so the top end stays soft
    // rather than clicky. Lightly randomised per key so it doesn't read as robotic.
    const playTick = () => {
      const ctx = getCtx();
      if (!ctx || ctx.state !== 'running') return;
      const t = ctx.currentTime;
      // shared rounding lowpass → pulled low so the top stays muted and round
      const lp = ctx.createBiquadFilter();
      lp.type = 'lowpass';
      lp.frequency.value = 2600 + Math.random() * 600;
      lp.connect(ctx.destination);

      // 1) Body — the thock: deep triangle with a quick downward pitch drop,
      //    weighted heavier and held a touch longer for a fuller knock.
      const body = ctx.createOscillator();
      const bg = ctx.createGain();
      body.type = 'triangle';
      const f0 = 158 + Math.random() * 30;
      body.frequency.setValueAtTime(f0, t);
      body.frequency.exponentialRampToValueAtTime(88, t + 0.07);
      bg.gain.setValueAtTime(0.0001, t);
      bg.gain.exponentialRampToValueAtTime(0.12, t + 0.006);
      bg.gain.exponentialRampToValueAtTime(0.0001, t + 0.13);
      body.connect(bg).connect(lp);
      body.start(t);
      body.stop(t + 0.15);

      // 2) Tap — subtle low-mid transient just for definition; kept quiet and dark
      //    so the body reads as the thock, not a click.
      const tap = ctx.createBufferSource();
      tap.buffer = getNoise(ctx);
      const bp = ctx.createBiquadFilter();
      bp.type = 'bandpass';
      bp.frequency.value = 1500 + Math.random() * 600;
      bp.Q.value = 0.9;
      const tg = ctx.createGain();
      tg.gain.setValueAtTime(0.0001, t);
      tg.gain.exponentialRampToValueAtTime(0.028, t + 0.002);
      tg.gain.exponentialRampToValueAtTime(0.0001, t + 0.016);
      tap.connect(bp).connect(tg).connect(lp);
      tap.start(t, Math.random() * 0.5, 0.025);
      tap.stop(t + 0.035);
    };
    // Deep whoosh: a dark low-passed noise sweep plus a sub-bass sine glide
    // underneath for weight, so the lift reads as a low *whump* not an airy hiss.
    const playWhoosh = () => {
      const ctx = getCtx();
      if (!ctx || ctx.state !== 'running') return;
      const t = ctx.currentTime;
      // body — low-passed noise, swept low so it stays dark
      const src = ctx.createBufferSource();
      src.buffer = getNoise(ctx);
      const lp = ctx.createBiquadFilter();
      lp.type = 'lowpass';
      lp.Q.value = 0.6;
      lp.frequency.setValueAtTime(160, t);
      lp.frequency.exponentialRampToValueAtTime(1000, t + 0.30);
      lp.frequency.exponentialRampToValueAtTime(200, t + 0.72);
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(0.17, t + 0.14);
      g.gain.exponentialRampToValueAtTime(0.0001, t + 0.76);
      src.connect(lp).connect(g).connect(ctx.destination);
      src.start(t);
      src.stop(t + 0.78);
      // sub — a quiet sine glide for depth
      const sub = ctx.createOscillator();
      const sg = ctx.createGain();
      sub.type = 'sine';
      sub.frequency.setValueAtTime(64, t);
      sub.frequency.exponentialRampToValueAtTime(140, t + 0.18);
      sub.frequency.exponentialRampToValueAtTime(50, t + 0.62);
      sg.gain.setValueAtTime(0.0001, t);
      sg.gain.exponentialRampToValueAtTime(0.10, t + 0.12);
      sg.gain.exponentialRampToValueAtTime(0.0001, t + 0.64);
      sub.connect(sg).connect(ctx.destination);
      sub.start(t);
      sub.stop(t + 0.66);
    };

    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const backspace = async () => {
      while (textEl.textContent && textEl.textContent.length) {
        textEl.textContent = textEl.textContent.slice(0, -1);
        playTick();
        await wait(46);
      }
    };
    const typeIn = async (str: string) => {
      for (const ch of str) { textEl.textContent += ch; playTick(); await wait(82); }
    };
    const armAudio = async () => {
      const ac = getCtx();
      // Wait for the context to actually resume so the sounds that fire right after
      // (whoosh, thocks) aren't dropped while it's still suspended — but CAP the wait
      // so a cold load with no user gesture (where resume() never settles) can't hang
      // the intro and leave the white overlay stuck (the original white-screen bug was
      // an uncapped await here). Gesture-driven replays resume under the cap and get
      // full sound; the cold first-visit intro plays on time, just silent until the
      // browser allows audio (first interaction).
      if (ac && ac.state === 'suspended') {
        try { await Promise.race([ac.resume(), new Promise((r) => setTimeout(r, 350))]); } catch {}
      }
    };
    const exit = () => {
      document.documentElement.style.overflow = '';
      playWhoosh();                          // overlay lifts away
      intro.classList.add('is-exiting');
      let done = false;
      const finish = () => { if (done) return; done = true; intro.classList.add('is-done'); signalDone(); };
      intro.addEventListener('transitionend', finish, { once: true });
      window.setTimeout(finish, 1000); // failsafe if transitionend doesn't fire
      try { sessionStorage.setItem('introSeen', '1'); } catch {}
    };

    let busy = false; // ignore brand re-clicks while an animation is playing

    // First visit: lift in "What's up?", backspace, type "Welcome.", lift away.
    const playFirstVisit = async () => {
      busy = true;
      try {
        document.documentElement.style.overflow = 'hidden'; // lock scroll while up
        await armAudio();                       // so the enter whoosh isn't swallowed
        textEl.textContent = "What's up?";
        await wait(280);
        intro.classList.add('is-lifted');     // lift the line in
        playWhoosh();
        caret.classList.add('is-blinking');
        await wait(950);                        // hold
        caret.classList.remove('is-blinking');  // steady while deleting/typing
        await backspace();
        await wait(240);
        await typeIn('Welcome.');
        caret.classList.add('is-blinking');
        await wait(1000);                       // hold
        exit();
        await wait(840);                        // let the lift finish before unlocking
      } catch {
        reveal();
      } finally {
        busy = false;
      }
    };

    // Reset the (hidden) overlay to its base state without playing the exit
    // transition in reverse — clear the lift/exit/egg classes while still
    // display:none, then reveal at base and commit before the next lift-in.
    const topbar = document.querySelector<HTMLElement>('.topbar');
    const resetForReplay = () => {
      intro.classList.remove('is-exiting', 'is-lifted', 'show-egg', 'show-arrow');
      topbar?.classList.remove('nav-spotlight');
      caret.classList.remove('is-blinking');
      textEl.textContent = '';
      void intro.offsetHeight;
      intro.classList.remove('is-done');
      void intro.offsetHeight;
    };

    // Brand re-click responses, by patience level. Caleb warms up, then slowly
    // wears down. Tier is chosen by click count (1..21). Each line shows at most
    // once per session; the 5th is a fixed "click my other buttons" pointer.
    const PATIENCE = [
      { upTo: 5,  lines: ['Hey!', "Caleb Lim! That's me!", 'Glad to be of help!', 'Yo!', 'Hello there!', 'Feel free to browse!'] },
      { upTo: 11, lines: ['Yep, still me.', 'Need something?', 'Hi again!', 'At your service.', 'Mhm?', 'Oh, hi.', 'Yes?'] },
      { upTo: 17, lines: ['Okay... You keep pressing...', 'Still me...', 'You good?', 'Hey! That tickles!', 'Easy there.', 'Why though?', 'Getting repetitive...'] },
      { upTo: 21, lines: ['Bro click somewhere else.', 'What now?', 'Again? Really?', 'Seriously?', "I've got work to do.", 'Stop poking me!'] },
    ];
    const GIFT_LINES = ['Here you go.', 'Another one.', 'Take this too.', 'All yours.', 'Here, have this.', 'Enjoy!'];

    // Lines already shown this session never repeat (persisted across reloads).
    let used = new Set<string>();
    try { used = new Set(JSON.parse(sessionStorage.getItem('brandUsed') || '[]')); } catch {}
    const remember = (line: string) => {
      used.add(line);
      try { sessionStorage.setItem('brandUsed', JSON.stringify([...used])); } catch {}
    };
    const pickFrom = (pool: string[], avoidRepeat = true) => {
      let cands = avoidRepeat ? pool.filter((l) => !used.has(l)) : pool;
      if (!cands.length) cands = pool;                 // pool exhausted → allow reuse
      const line = cands[Math.floor(Math.random() * cands.length)];
      if (avoidRepeat) remember(line);
      return line;
    };
    const pickLine = (pos: number) => {
      const tier = PATIENCE.find((p) => pos <= p.upTo) ?? PATIENCE[PATIENCE.length - 1];
      return pickFrom(tier.lines);
    };

    // A cheery NES-style "you got an item" fanfare for the easter egg.
    const playFanfare = () => {
      const ctx = getCtx();
      if (!ctx || ctx.state !== 'running') return;
      const t0 = ctx.currentTime + 0.03;
      const master = ctx.createGain();
      master.gain.value = 0.9;
      const soft = ctx.createBiquadFilter();
      soft.type = 'lowpass';
      soft.frequency.value = 4200;
      master.connect(soft).connect(ctx.destination);
      const blip = (f: number, st: number, d: number, g = 0.09) => {
        const o = ctx.createOscillator();
        const ge = ctx.createGain();
        o.type = 'square';
        o.frequency.setValueAtTime(f, t0 + st);
        ge.gain.setValueAtTime(0.0001, t0 + st);
        ge.gain.exponentialRampToValueAtTime(g, t0 + st + 0.012);
        ge.gain.exponentialRampToValueAtTime(0.0001, t0 + st + d);
        o.connect(ge).connect(master);
        o.start(t0 + st);
        o.stop(t0 + st + d + 0.02);
      };
      blip(659, 0.00, 0.11);          // E5
      blip(784, 0.11, 0.11);          // G5
      blip(988, 0.22, 0.11);          // B5
      blip(1319, 0.33, 0.42);         // E6 (held lead)
      blip(1568, 0.33, 0.42, 0.05);   // G6 harmony
      blip(2093, 0.70, 0.09, 0.05);   // sparkle
      blip(2637, 0.80, 0.12, 0.05);   // sparkle up
    };

    // Session click count persists across reloads within the tab.
    let clicks = Number(sessionStorage.getItem('brandClicks') || '0');
    const egg = intro.querySelector<HTMLImageElement>('[data-intro-egg]');
    let eggSrcs: string[] = [];
    try { eggSrcs = JSON.parse(egg?.dataset.eggSrcs || '[]'); } catch {}

    const playBothered = async () => {
      if (busy) return;
      busy = true;
      clicks += 1;
      try { sessionStorage.setItem('brandClicks', String(clicks)); } catch {}

      // Once 22 is reached it stays in "gift" mode: every click hands over another
      // asset with the chiptune + pop. Click 22 is the grudging first reveal.
      const isGift = clicks >= 22;
      const isArrow = clicks === 5;
      let line: string;
      if (clicks === 22) line = 'Okay! Okay! Fine. You can have this.';
      else if (isGift) line = pickFrom(GIFT_LINES, false);
      else if (isArrow) line = 'I have other buttons you can click!';
      else line = pickLine(clicks);

      try {
        resetForReplay();
        document.documentElement.style.overflow = 'hidden';
        await armAudio();
        await wait(60);                         // let the overlay paint
        intro.classList.add('is-lifted');
        playWhoosh();                            // line lifts in
        caret.classList.add('is-blinking');
        await wait(420);
        caret.classList.remove('is-blinking');
        await typeIn(line);
        caret.classList.add('is-blinking');

        if (isGift) {
          await wait(380);
          if (egg && eggSrcs.length) {
            egg.src = eggSrcs[(clicks - 22) % eggSrcs.length];
            // Decode the image BEFORE the pop. On phones the portrait JPG can take
            // longer than the 620ms egg-pop to decode, so without this the animation
            // finishes before the image paints and the photo just appears with no pop.
            // Cap the wait so a slow/failed load can't stall the reveal.
            try { await Promise.race([egg.decode(), new Promise((r) => setTimeout(r, 1500))]); } catch {}
          }
          intro.classList.add('show-egg');       // pop the photo in
          playFanfare();
          await wait(2600);                       // hold on the reveal
        } else if (isArrow) {
          topbar?.classList.add('nav-spotlight');  // lift the nav above the overlay
          intro.classList.add('show-arrow');
          await wait(2400);                         // hold so they see the pointer
          intro.classList.remove('show-arrow');
          topbar?.classList.remove('nav-spotlight');
        } else {
          await wait(1100);                       // hold on the line
        }

        exit();
        await wait(840);
      } catch {
        intro.classList.add('is-done');
        document.documentElement.style.overflow = '';
        topbar?.classList.remove('nav-spotlight');
      } finally {
        busy = false;
      }
    };

    // Pastel confetti + stars burst from an element's centre. Pure DOM + CSS;
    // the layer cleans itself up after the animation.
    const PASTELS = ['#ffd1dc', '#c1e1ff', '#c9f0d1', '#fff3b0', '#e3d0ff', '#ffd8be', '#b5ead7', '#cdb4ff'];
    const burst = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const layer = document.createElement('div');
      layer.className = 'confetti-layer';
      document.body.appendChild(layer);
      for (let i = 0; i < 30; i++) {
        const bit = document.createElement('span');
        const isStar = i % 2 === 0;
        bit.className = 'confetti-bit' + (isStar ? ' is-star' : '');
        const color = PASTELS[Math.floor(Math.random() * PASTELS.length)];
        if (isStar) bit.style.color = color; else bit.style.background = color;
        const angle = Math.random() * Math.PI * 2;
        const dist = 90 + Math.random() * 160;
        bit.style.left = cx + 'px';
        bit.style.top = cy + 'px';
        bit.style.setProperty('--tx', Math.cos(angle) * dist + 'px');
        bit.style.setProperty('--ty', (Math.sin(angle) * dist - 30) + 'px'); // slight upward bias
        bit.style.setProperty('--rot', (Math.random() * 720 - 360) + 'deg');
        bit.style.setProperty('--dur', (750 + Math.random() * 550) + 'ms');
        layer.appendChild(bit);
      }
      window.setTimeout(() => layer.remove(), 1500);
    };

    // Phone first-visit: a "tap to enter" button instead of auto-playing. The tap is
    // the gesture that unlocks WebAudio, so the intro that follows has sound. The tap
    // pops the button to "Success!" with a confetti + stars burst, then hands off to
    // the intro sequence.
    const isPhone = window.matchMedia('(max-width: 700px)').matches;
    const enterBtn = intro.querySelector<HTMLButtonElement>('[data-intro-enter]');
    const enterLabel = intro.querySelector<HTMLElement>('[data-ie-label]');
    const showEnter = () => {
      document.documentElement.style.overflow = 'hidden'; // lock scroll under the overlay
      intro.removeAttribute('aria-hidden');                // make the button reachable
      intro.classList.add('enter-mode');
      let used = false;
      enterBtn!.addEventListener('click', async () => {
        if (used) return;
        used = true;
        // Unlock audio inside the gesture so the intro thocks + whoosh play.
        const ctx = getCtx();
        if (ctx && ctx.state === 'suspended') { try { await ctx.resume(); } catch {} }
        enterBtn!.classList.add('is-success');
        if (enterLabel) enterLabel.textContent = 'Success!';
        burst(enterBtn!);
        playFanfare();                                     // celebratory chime
        await wait(950);                                   // hold on the success + confetti
        intro.classList.remove('enter-mode');
        intro.setAttribute('aria-hidden', 'true');
        await wait(140);
        playFirstVisit();                                  // intro types in, now audible
      });
    };

    // First-visit run. Reduced-motion / already-seen → reveal at once. On phones, gate
    // behind tap-to-enter (for sound); on desktop, auto-play.
    if (reduced || seen) reveal();
    else if (isPhone && enterBtn) showEnter();
    else playFirstVisit();

    // Wire the top-left brand link to replay the bothered version. Only when motion
    // is allowed — under reduced-motion the link just navigates home as normal.
    if (!reduced) {
      const brand = document.querySelector<HTMLAnchorElement>('.topbar .brand');
      brand?.addEventListener('click', (e) => {
        e.preventDefault();
        playBothered();
      });
    }
  })();

  // Run a callback once the intro overlay is done (or immediately if it already
  // finished / isn't present, e.g. a page without the intro).
  const onIntroDone = (cb: () => void) => {
    if ((window as any).__introDone || !document.querySelector('[data-intro]')) cb();
    else document.addEventListener('intro:done', cb, { once: true });
  };

  // Cycling typed greeting above the name. Types a line out, holds, deletes, and
  // moves to the next — looping. Held until the intro completes so the two typers
  // don't run at once. Reduced-motion users just see the first line.
  const greetEl = document.querySelector<HTMLElement>('[data-greet]');
  if (greetEl) {
    const greetings = [
      "Nice to meet you.",
      "Hi there, glad you stopped by.",
      "Let's make something good.",
      "Coffee's on me.",
      "Pull up a chair.",
      "Ready when you are.",
    ];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      greetEl.textContent = greetings[0];
    } else {
      let gi = 0, ci = 0, deleting = false;
      const tick = () => {
        const word = greetings[gi];
        ci += deleting ? -1 : 1;
        greetEl.textContent = word.slice(0, ci);
        let delay = deleting ? 45 : 80;
        if (!deleting && ci === word.length) { deleting = true; delay = 1700; }
        else if (deleting && ci === 0) { deleting = false; gi = (gi + 1) % greetings.length; delay = 350; }
        window.setTimeout(tick, delay);
      };
      onIntroDone(() => window.setTimeout(tick, 600));
    }
  }

  // Portrait carousel — Instagram-style slide cycler with prev/next arrows, dot
  // indicators, and auto-advance every data-bp-interval ms (default 5000). One
  // root supported per page (the splash hero portrait), but the selector loop
  // tolerates any future instances.
  const portraitCarousels = document.querySelectorAll<HTMLDivElement>('[data-portrait-carousel]');
  portraitCarousels.forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-bp-track]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-bp-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-bp-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-bp-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-bp-next]');
    if (!track || slides.length === 0) return;
    const intervalMs = Number(root.dataset.bpInterval ?? '5000');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    let timerId: number | null = null;
    let isAnimating = false;

    type Dir = 'left' | 'right' | 'top' | 'bottom';
    const DIRS: Dir[] = ['left', 'right', 'top', 'bottom'];
    const OPP: Record<Dir, Dir> = { left: 'right', right: 'left', top: 'bottom', bottom: 'top' };
    const vec = (d: Dir): string => {
      switch (d) {
        case 'left':   return 'translate3d(-100%, 0, 0)';
        case 'right':  return 'translate3d(100%, 0, 0)';
        case 'top':    return 'translate3d(0, -100%, 0)';
        case 'bottom': return 'translate3d(0, 100%, 0)';
      }
    };

    // Slide 0 and dot 0 are rendered .is-active by the Astro template above —
    // no JS-side init needed.

    const transitionTo = (nextIndex: number, dir: Dir) => {
      if (isAnimating || nextIndex === index) return;
      isAnimating = true;
      const incoming = slides[nextIndex];
      const outgoing = slides[index];

      // Pre-position incoming off-screen on the chosen axis (no transition so
      // it doesn't visibly fly to the off-screen spot before animating back in).
      // .is-active is added in the same frame as the animate-in transform, which
      // also flips opacity to 1 — so the slide is opaque the whole way across.
      incoming.style.transition = 'none';
      incoming.style.transform = vec(dir);
      // Force reflow so the off-screen transform takes effect before we
      // re-enable transitions for the animate-in.
      void incoming.offsetWidth;
      incoming.style.transition = '';
      incoming.style.transform = 'translate3d(0, 0, 0)';
      incoming.classList.add('is-active');

      // Outgoing rides off the opposite edge AT FULL OPACITY (via .is-leaving)
      // so the two slides tile the frame edge-to-edge with no black gap mid-swap.
      outgoing.classList.remove('is-active');
      outgoing.classList.add('is-leaving');
      outgoing.style.transform = vec(OPP[dir]);

      index = nextIndex;
      dots.forEach((d, n) => {
        d.classList.toggle('is-active', n === index);
        if (n === index) {
          d.setAttribute('aria-current', 'true');
        } else {
          d.removeAttribute('aria-current');
        }
      });

      const onDone = (e: TransitionEvent) => {
        if (e.target !== incoming || e.propertyName !== 'transform') return;
        incoming.removeEventListener('transitionend', onDone);
        // Drop .is-leaving (snaps outgoing back to opacity 0) and reset its
        // inline transform without animating, so a future turn starts clean.
        outgoing.classList.remove('is-leaving');
        outgoing.style.transition = 'none';
        outgoing.style.transform = '';
        void outgoing.offsetWidth;
        outgoing.style.transition = '';
        isAnimating = false;
      };
      incoming.addEventListener('transitionend', onDone);
    };

    // Direction policy — uses standard carousel convention (next = strip scrolls left):
    //   - forward (next-button / ArrowRight / dot ahead): incoming from RIGHT, motion leftward
    //   - backward (prev-button / ArrowLeft / dot behind): incoming from LEFT, motion rightward
    //   - auto-advance non-wrap tick:                      random of the four
    //   - auto-advance forward wrap (last → first):        incoming from RIGHT ("left slide")
    type Motion = 'auto' | 'forward' | 'backward';
    const go = (target: number, motion: Motion) => {
      const nextIndex = (target + slides.length) % slides.length;
      if (nextIndex === index) return;
      let dir: Dir;
      if (motion === 'forward')       dir = 'right';
      else if (motion === 'backward') dir = 'left';
      else {
        const isForwardWrap = index === slides.length - 1 && nextIndex === 0;
        dir = isForwardWrap ? 'right' : DIRS[Math.floor(Math.random() * DIRS.length)];
      }
      transitionTo(nextIndex, dir);
    };

    const stop = () => {
      if (timerId !== null) { window.clearInterval(timerId); timerId = null; }
    };
    const start = () => {
      stop();
      // Respect reduced-motion: do not auto-advance for users with the preference.
      if (prefersReduced.matches) return;
      // Skip the auto-advance entirely when the tab is hidden — saves work and
      // avoids stacking advances when the user returns.
      if (document.hidden) return;
      if (intervalMs <= 0) return;
      timerId = window.setInterval(() => go(index + 1, 'auto'), intervalMs);
    };
    // Reset the auto-advance countdown each time the user manually interacts —
    // their action wins, and the next auto-advance fires 5s after that input.
    prev?.addEventListener('click', () => { go(index - 1, 'backward'); start(); });
    next?.addEventListener('click', () => { go(index + 1, 'forward');  start(); });
    dots.forEach((d, n) => d.addEventListener('click', () => {
      // Jump-to-dot: pick direction by which way the target lies along the strip.
      go(n, n > index ? 'forward' : 'backward');
      start();
    }));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(index + 1, 'forward');
        start();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(index - 1, 'backward');
        start();
      }
    });
    // Pause cycling while the user is hovering (they're studying a slide); resume
    // immediately when they leave.
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    // Tab-visibility pause: stop the timer when the tab goes hidden, resume on
    // return so the user doesn't see a flurry of catch-up advances.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop(); else start();
    });
    // Reduced-motion preference can toggle at runtime (rare but possible) — honor it.
    prefersReduced.addEventListener?.('change', () => { if (prefersReduced.matches) stop(); else start(); });
    start();
  });
</script>

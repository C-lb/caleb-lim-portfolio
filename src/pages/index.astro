---
import Base from '../layouts/Base.astro';
import DisciplineCard from '../components/DisciplineCard.astro';
import { CATEGORIES, type Category } from '../content/categories';
import { DISCIPLINE_ACCENT, DISCIPLINE_K } from '../styles/disciplines';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import portrait1 from '../assets/portrait.jpg';
import portrait2 from '../assets/portrait2.JPG';
import portrait3 from '../assets/portrait3.jpg';
import portrait4 from '../assets/portrait4.jpg';
import portrait5 from '../assets/portrait5.jpeg';
const portraits = [portrait1, portrait2, portrait3, portrait4, portrait5];
// Optional per-slide caption. Null = no caption.
// 2026-05-18 (UAT): captions on 2/3/4 — portraits 1 and 5 caption-less.
const portraitCaptions: (string | null)[] = [null, 'graphic design', 'event hosting', 'social impact', null];

// SPLASH-04 / D-07: drop cards for empty disciplines. Build-time count of
// non-draft pieces per category. Personal often empty at launch.
const allPieces = await getCollection('pieces', ({ data }) => data.draft !== true);
const countByCategory: Record<Category, number> = {
  design: 0, finance: 0, personal: 0, saas: 0,
};
for (const piece of allPieces) {
  countByCategory[piece.data.category]++;
}
// 2026-05-18 (UAT-driven): user reversed Phase 3's SPLASH-04 drop-empty-cards
// rule. Splash now shows all 4 disciplines always — populated ones link to /{cat},
// empty ones render as non-clickable placeholders with a "coming soon" cue. The
// thesis (4 disciplines, cross-functional) reads clearly even at launch when only
// 2 are populated.
// Splash render order is intentionally distinct from CATEGORIES (which is the
// canonical content/route order). 2026-05-18 (UAT): swapped marketing and
// personal so the populated marketing card sits next to the populated design
// card in row 1's pair-with-placeholder rhythm.
const allCategoriesOnSplash: readonly Category[] = ['design', 'finance', 'saas', 'personal'];
// 2026-06-26: the role labels (analyst / brand strategist / designer / marketer)
// under CALEB LIM were removed at the owner's request, along with their
// scroll-to-card interaction.
// N-card grid template (UI-SPEC.md lines 446-451). With placeholder cards landed
// 2026-05-18 the splash always shows 4 cards, so the 4-card template is the only
// one that fires in practice — the other entries kept for forward-compat with
// future scope changes (e.g., a 5th discipline).
// 2026-05-18 (UAT): 4-card layout flipped from a single row (1.2fr 0.85fr 1fr 1fr)
// to a 2x2 matrix — two columns, two rows. Reads as a balanced grid rather than
// a wide horizontal sweep, and pairs each populated card next to its placeholder
// counterpart at desktop widths.
// 2026-06-26 (redesign): cards deploy on a real 12-column grid — four cards span
// 3 columns each, a single scannable row on desktop (collapses to 2 then 1 col via
// the media queries below). The 2x2 matrix is retired.
const gridTemplate = {
  4: 'repeat(12, 1fr)',
  3: 'repeat(12, 1fr)',
  2: '1fr 1fr',
  1: '1fr',
}[allCategoriesOnSplash.length] ?? 'repeat(12, 1fr)';
// DISCIPLINE_ACCENT is imported to keep the splash's k→accent contract co-located
// even though the card component owns its own CSS; suppress unused-import lint.
void DISCIPLINE_ACCENT;
---
<Base title="Caleb Lim — Portfolio" bg="paper">
  <section class="b-splash">
    <div class="b-hero">
      <div class="b-portrait" data-portrait-carousel data-bp-interval="3000">
        <div class="bp-track" data-bp-track>
          {portraits.map((src, i) => (
            <div class={`bp-slide${i === 0 ? ' is-active' : ''}`} data-bp-slide>
              <Image
                src={src}
                alt={`Portrait of Caleb Lim, photo ${i + 1}`}
                widths={[280, 560]}
                sizes="(max-width: 900px) 100vw, 280px"
                priority={i === 0}
              />
              {portraitCaptions[i] && <span class="bp-caption">{portraitCaptions[i]}</span>}
            </div>
          ))}
        </div>
        <button class="bp-arrow bp-arrow-prev" data-bp-prev type="button" aria-label="Previous photo">‹</button>
        <button class="bp-arrow bp-arrow-next" data-bp-next type="button" aria-label="Next photo">›</button>
        <div class="bp-dots" data-bp-dots role="group" aria-label="Portrait photo selector">
          {portraits.map((_, i) => (
            <button
              class={`bp-dot${i === 0 ? ' is-active' : ''}`}
              data-bp-dot={i}
              type="button"
              aria-label={`Photo ${i + 1}`}
              {...(i === 0 ? { 'aria-current': 'true' } : {})}
            ></button>
          ))}
        </div>
        <div class="bp-glass" aria-hidden="true"></div>
      </div>
      <div class="b-name">
        <p class="b-greeting" aria-live="polite"><span class="greet" data-greet></span><span class="greet-caret" aria-hidden="true"></span></p>
        <h1><span class="im">I'm</span> CALEB<br /><span class="lim">LIM</span></h1>
      </div>
    </div>

    <a href="/about" class="b-bio">
        <span class="bb-warp" aria-hidden="true"></span>
        <span class="bb-tint" aria-hidden="true"></span>
        <span class="bb-edge" aria-hidden="true"></span>
        <div class="b-bio-head">
          <span class="b-bio-tag"><span class="b-bio-tag-star" aria-hidden="true">★</span> ABOUT</span>
          <h2>the short version</h2>
          <span class="b-bio-arrow"><span class="b-bio-arrow-glyph" aria-hidden="true">→</span> KEEP READING</span>
        </div>
        <p>I never learned to pick one lane. Some weeks I'm deep in a financial model, others I'm drawing a brand or writing the words that tie it all together. What I care about most is the people the work is really for. Have a look around, and if something clicks, come say hi.</p>
      </a>

    <div id="cards" class="b-cards" style={`grid-template-columns: ${gridTemplate}`}>
      {allCategoriesOnSplash.map((cat, i) => (
        <DisciplineCard
          category={cat}
          k={DISCIPLINE_K[cat]}
          index={(i + 1) as 1 | 2 | 3 | 4}
          isEmpty={countByCategory[cat] === 0}
        />
      ))}
    </div>
  </section>
</Base>

<style>
  /* --- Sketch lines 283-530 verbatim, adapted to scoped Astro --- */
  .b-splash {
    min-height: calc(100vh - 120px); /* leave room for Base topbar + footer */
    /* 2026-06-26 (redesign): more breathing room + a centred max-width so the
       layout doesn't sprawl edge-to-edge on wide screens. */
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(20px, 3.5vw, 40px);
    display: grid;
    /* 2026-06-26: three stacked bands — header (portrait + name), then the about-me
       card, then the discipline picker. */
    grid-template-rows: auto auto auto;
    align-content: space-between;
    gap: clamp(24px, 3.4vw, 44px);
  }

  /* HEADER BAND: portrait (3) | name (9). */
  .b-hero {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(20px, 3vw, 44px);
    align-items: center;
    min-height: 0;
  }
  .b-hero > .b-portrait { grid-column: span 3; }
  .b-hero > .b-name     { grid-column: span 9; }
  .b-portrait {
    background: var(--ink);
    border-radius: 18px; /* matches the glass cards */
    overflow: hidden;
    position: relative;
    aspect-ratio: 4/5; /* keep portrait shape; carousel slides fill this box */
    /* Slightly smaller now that the about-me card sits below the header. */
    width: 100%;
    max-width: 260px;
    justify-self: start;
    box-shadow: 0 22px 48px -26px rgba(10, 10, 10, 0.7);
  }
  /* Liquid-glass frame: a lit bevel rim over the photo so the portrait reads as a
     card set in glass (the photo stays fully visible; this is the .edge layer of the
     glass recipe). pointer-events:none so the carousel arrows/dots stay clickable. */
  .b-portrait .bp-glass {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    border-radius: inherit;
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow:
      inset 1.5px 1.5px 1px rgba(255, 255, 255, 0.45),
      inset -1px -1px 1px rgba(255, 255, 255, 0.18),
      inset 0 0 34px rgba(255, 255, 255, 0.06);
  }
  /* 2026-05-18 (UAT v2): slides are absolutely stacked; each transitions
     independently. JS pre-positions the incoming slide off-screen on the
     chosen axis, then animates it to (0,0); the outgoing slide exits to
     the opposite edge. Lets auto-advance pick random directions while
     keeping click/wrap motion deterministic. */
  .b-portrait .bp-track {
    position: absolute;
    inset: 0;
  }
  .b-portrait .bp-slide {
    position: absolute;
    inset: 0;
    background: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: var(--sp-2);
    /* Each slide carries the same corner radius as the outer .b-portrait frame so
       the photo's curved edge reads even during the slide-in (when it crosses the
       container midline, the curve preserves the card-shape silhouette). */
    border-radius: inherit;
    overflow: hidden;
    opacity: 0;
    /* Only transform animates — opacity is binary (idle slides invisible, in-flight
       slides fully opaque). Keeping both slides at opacity 1 during the swap means
       they tile the frame edge-to-edge and the dark .b-portrait backdrop never
       flashes through. */
    transition: transform 650ms cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }
  .b-portrait .bp-slide.is-active,
  .b-portrait .bp-slide.is-leaving {
    opacity: 1;
  }
  .b-portrait .bp-slide.is-active  { z-index: 2; }
  .b-portrait .bp-slide.is-leaving { z-index: 1; }
  @media (prefers-reduced-motion: reduce) {
    .b-portrait .bp-slide { transition: none; }
  }
  .b-portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
  }
  /* Per-slide caption overlay. Mono, white, anchored to bottom-left. A soft
     bottom-gradient sits behind the text so it stays legible against any photo. */
  .b-portrait .bp-caption {
    position: absolute;
    left: 14px;
    bottom: 52px; /* clears the dot pill with room to breathe */
    color: var(--paper);
    font-family: var(--mono);
    font-size: var(--fs-mono); /* was 11px; exact match per 05-TOKEN-MAP */
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6); /* legibility over varied photo backgrounds */
    z-index: 1;
    line-height: 1;
  }
  .b-portrait .bp-slide::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 80px;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.45), transparent);
    pointer-events: none;
    opacity: 0;
    transition: opacity 250ms ease;
  }
  /* Only show the bottom gradient on slides that actually carry a caption. */
  .b-portrait .bp-slide:has(.bp-caption)::after {
    opacity: 1;
  }
  /* Wireframe slides — dashed-border placeholders for future portraits. Mirrors the
     /about page wireframe pattern (PHOTO · 0X + hint) so the visual language is consistent. */
  .b-portrait .bp-wireframe {
    background: rgba(15, 13, 12, 0.92);
    color: var(--paper);
    border: 2px dashed var(--terracotta);
    border-radius: 6px;
    inset: 6px; /* small inset so the dashed border reads inside the rounded outer frame */
  }
  .b-portrait .bp-tag {
    font-family: var(--mono);
    font-size: var(--fs-mono); /* was 11px; exact match per 05-TOKEN-MAP */
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  .b-portrait .bp-hint {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: var(--fs-ttl); /* was 18px; migrated to --fs-ttl (22px) per 05-TOKEN-MAP — nearest existing step */
    opacity: 0.85;
  }
  /* Hover-revealed prev/next arrows. Hidden by default; shown when the carousel
     is hovered or any of its controls receives keyboard focus. */
  .b-portrait .bp-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    /* Anti-vibecode glass control: translucent dark fill, lit rim, soft shadow. */
    background: rgba(20, 18, 16, 0.42);
    backdrop-filter: blur(6px) saturate(1.2);
    -webkit-backdrop-filter: blur(6px) saturate(1.2);
    color: var(--paper);
    border: 1px solid rgba(255, 255, 255, 0.28);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.30),
      0 8px 18px -8px rgba(0, 0, 0, 0.55);
    cursor: pointer;
    opacity: 0;
    transition: opacity 180ms ease, background-color 180ms ease, transform 180ms ease;
    font-size: var(--fs-ttl); /* was 22px; exact match per 05-TOKEN-MAP */
    line-height: 1;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }
  .b-portrait:hover .bp-arrow,
  .b-portrait:focus-within .bp-arrow { opacity: 1; }
  .b-portrait .bp-arrow:hover { background: rgba(20, 18, 16, 0.62); transform: translateY(-50%) scale(1.08); }
  .b-portrait .bp-arrow:focus-visible { outline: 2px solid var(--paper); outline-offset: 2px; }
  .b-portrait .bp-arrow-prev { left: 8px; }
  .b-portrait .bp-arrow-next { right: 8px; }
  /* Instagram-style dot indicators at the bottom. The active dot is larger and
     fully opaque paper; inactive dots are semi-transparent paper. */
  .b-portrait .bp-dots {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    z-index: 2;
    /* Anti-vibecode glass pill so the dots read over any photo. */
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(20, 18, 16, 0.38);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }
  /* Tap target: 24×24 button shell (WCAG 2.5.5 / Lighthouse target-size). Visible
     8×8 dot rendered via ::before pseudo so the surface remains identical but the
     hit area doubles. Active state animates the pseudo, not the button. */
  .b-portrait .bp-dot {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: none;
    background: transparent;
    cursor: pointer;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .b-portrait .bp-dot::before {
    content: '';
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(242, 235, 219, 0.45);
    transition: background-color 180ms ease, transform 180ms ease;
  }
  .b-portrait .bp-dot.is-active::before {
    background: var(--paper);
    transform: scale(1.25);
  }
  .b-portrait .bp-dot:focus-visible { outline: 2px solid var(--paper); outline-offset: 2px; }

  .b-name {
    position: relative;
    padding: 8px 0;
  }
  .b-name h1 {
    font-family: var(--sans);
    font-weight: 800;
    /* Slightly smaller than --fs-display to make room for the about-me band. */
    font-size: clamp(52px, 8.4vw, 124px);
    line-height: var(--lh-display);
    letter-spacing: -0.045em;
    text-transform: uppercase;
    font-variation-settings: "wdth" 100, "opsz" 96;
    margin: 0;
  }
  .b-name h1 .lim { color: var(--terracotta); }
  /* Typed, cycling greeting line above the name. */
  .b-greeting {
    font-family: var(--sans);
    font-size: clamp(18px, 2.1vw, 26px);
    font-weight: 500;
    line-height: 1.15;
    color: var(--ink);
    opacity: 0.92;
    margin: 0 0 var(--sp-3);
    min-height: 1.3em; /* reserve a line so the name doesn't jump while typing */
    display: flex;
    align-items: center;
  }
  .greet-caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 4px;
    background: var(--design);
    animation: caret-blink 1s steps(1) infinite;
  }
  @keyframes caret-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .greet-caret { animation: none; } }
  /* Small "I'm" lead-in above the giant name. */
  .b-name h1 .im {
    display: block;
    font-size: clamp(22px, 2.6vw, 34px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: none;
    color: var(--ink);
    margin-bottom: var(--sp-1);
  }
  .b-name .roles {
    display: flex;
    flex-wrap: wrap;
    /* 10px gap — combined with role-link vertical padding below this puts safe
       target-spacing diameter ≥24px (WCAG 2.5.5 Lighthouse target-size). */
    gap: 10px;
    margin-top: var(--sp-5);
    font-size: var(--fs-body);
    line-height: var(--lh-tight);
  }
  /* Role-link tap target: ≥24×24. Vertical padding 5px on a 15.5px font (1.0 line-height)
     gives ~25.5px height; horizontal stays 8px so the visible "analyst" / "marketer"
     surface isn't visually inflated. Plan 05-09 Task 2 deviation (target-size on
     role-links was not enumerated in the plan but surfaced in the post-Task-3 re-audit). */
  .b-name .roles a.role-link {
    padding: 5px 8px;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 120ms ease;
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }
  /* Role labels: odd children (analyst, designer) = deeper teal-sage; even (brand
     strategist, marketer) = deeper terracotta-brown. Plan 05-09 Task 2 (SC2 a11y
     closure): role-link colors MUST meet WCAG AA 4.5:1 on --paper, so they pull
     from --role-link-odd/even (5.20 / 6.79) rather than --teal/--terracotta (2.02 /
     ~3.4 — those tokens stay for their decorative/hover-feedback roles elsewhere).
     The visible-difference from the broader palette is intentional for nav legibility.
     Still decoupled from Finance/Design discipline accents — role labels are
     decorative typography on the splash, not a discipline-identity statement. */
  .b-name .roles a.role-link:nth-child(odd)  { color: var(--role-link-odd);  font-weight: 500; font-family: var(--sans); }
  .b-name .roles a.role-link:nth-child(even) { color: var(--role-link-even); font-style: italic; font-family: var(--serif); font-weight: 400; }
  /* D-06 Touch-hover gate (Plan 05-07 Task 1). Role-link hover styles only fire
     on devices with a real hover mechanism — the original combined rule split
     into a gated :hover and an UNGATED :focus-visible so keyboard focus on a
     touch device with attached keyboard still produces the underline+opacity
     feedback (and the outline rule that follows). */
  @media (hover: hover) and (pointer: fine) {
    .b-name .roles a.role-link:hover { opacity: 0.7; text-decoration: underline; text-underline-offset: 3px; }
  }
  .b-name .roles a.role-link:focus-visible { opacity: 0.7; text-decoration: underline; text-underline-offset: 3px; }
  .b-name .roles a.role-link:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; border-radius: 2px; }

  /* Cards get scroll-margin so they don't kiss the viewport edge when scrolled into view */
  :global(.b-card) { scroll-margin-top: var(--sp-6); }

  /* BIO STICKER — clickable card pattern, mirrors discipline cards.
     2026-05-18 (UAT): rest tilt extracted into --rest-rotate so the entrance
     shake @keyframes (defined below, same shape as the discipline-card shake)
     can compose against it via calc(). */
  /* 2026-05-18 (UAT): bg reverted to acid (turmeric); text + ink-family glyphs
     stay ink — same ink-on-light treatment as k2 Finance and k3 Personal so
     the bio card reads as a peer of the disciplines. */
  /* About-me is now a full-width horizontal band between the header and the cards:
     a left rail (eyebrow / heading / keep-reading) and the paragraph on the right. */
  .b-bio {
    --rest-rotate: 0deg;
    display: grid;
    grid-template-columns: minmax(200px, 320px) 1fr;
    column-gap: clamp(28px, 4vw, 64px);
    align-items: center;
    background: transparent;
    color: var(--paper);
    border-radius: 18px;
    padding: clamp(22px, 2.6vw, 34px) clamp(26px, 3vw, 44px);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transform: rotate(var(--rest-rotate));
    text-decoration: none;
    cursor: pointer;
    box-shadow: 0 22px 48px -26px rgba(10, 10, 10, 0.7);
    transition: transform 0.38s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.35s ease;
  }
  /* Left rail: a tight stack (eyebrow / heading / keep-reading). */
  .b-bio-head {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-2);
  }
  @media (max-width: 760px) {
    .b-bio {
      grid-template-columns: 1fr;
      row-gap: var(--sp-3);
    }
  }
  /* Liquid-glass four-layer stack (same recipe as DisciplineCard). */
  .b-bio .bb-warp {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    backdrop-filter: blur(3px) saturate(1.3);
    -webkit-backdrop-filter: blur(3px) saturate(1.3);
    filter: url(#glass-distortion);
    pointer-events: none;
  }
  .b-bio .bb-tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background: rgba(12, 11, 10, 0.55);
    pointer-events: none;
    transition: background 0.32s ease;
  }
  .b-bio .bb-edge {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    border: 1px solid rgba(255, 255, 255, 0.20);
    box-shadow:
      inset 1.5px 1.5px 1px rgba(255, 255, 255, 0.40),
      inset -1px -1px 1px rgba(255, 255, 255, 0.16),
      inset 0 0 22px rgba(255, 255, 255, 0.05);
    pointer-events: none;
  }
  /* Bio entrance shake is hover-gated per Plan 05-07 planner discretion
     (notes.planner_discretion). On touch (where (hover: none) is true) the
     D-07 entrance shimmer added in Plan 05-07 Task 2 is the substitute
     entrance motion — gating bio-shake to (hover: hover) prevents the rare
     ~1150ms overlap window where shimmer would clobber bio-shake mid-flight.
     D-08 still classifies bio-shake first-paint as EXEMPT under
     prefers-reduced-motion: no-preference; the reduced-motion
     `.b-bio { animation: none }` rule from Plan 05-06 stays OUTSIDE this
     hover gate (see ~50 lines below). */
  @media (hover: hover) and (pointer: fine) {
    .b-bio {
      animation: bio-shake 750ms ease-in-out 400ms 1;
    }
  }
  /* Content sits above the glass layers (warp/tint/edge are z-index 0–2). */
  .b-bio > .b-bio-head,
  .b-bio > p { position: relative; z-index: 3; }
  /* D-06 Touch-hover gate (Plan 05-07 Task 1). Bio-card 3D tilt + glass overlay
     + entrance-shake pause only fire on devices with a real hover mechanism.
     On touch, the entrance shimmer (added in Task 2) is the substitute
     micro-interaction; first tap navigates to /about. */
  @media (hover: hover) and (pointer: fine) {
    .b-bio:hover {
      /* 2026-06-26: clean straight lift (no tilt) to match the discipline cards. */
      transform: translateY(-4px);
      box-shadow:
        0 14px 28px rgba(15, 13, 12, 0.24),
        0 4px 10px rgba(15, 13, 12, 0.14);

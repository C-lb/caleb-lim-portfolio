    35%  { box-shadow: 0 22px 48px -26px rgba(10, 10, 10, 0.7), 0 0 26px 1px rgba(242, 235, 219, 0.16); }
    100% { box-shadow: 0 22px 48px -26px rgba(10, 10, 10, 0.7), 0 0 0 0 rgba(242, 235, 219, 0); }

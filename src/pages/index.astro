    45%      { transform: rotate(calc(var(--rest-rotate) - 0.8deg)) translateX(-0.6px); }
    60%      { transform: rotate(calc(var(--rest-rotate) + 0.8deg)) translateX(0.6px); }
    75%      { transform: rotate(calc(var(--rest-rotate) - 0.4deg)); }
    90%      { transform: rotate(calc(var(--rest-rotate) + 0.4deg)); }
  }
  /* Surgical reduced-motion disable for the 750ms bio entrance shake (D-08 #4,
     05-RESEARCH §3.4 step 2). Hover-tilt, liquid-glass fade, and the static rest
     tilt (rotate 0.5deg) remain exempt — they are not animations and are not
     touched here. The carousel slide-transition guard for `.b-portrait .bp-slide`
     stays at its existing position (~line 204). */
  @media (prefers-reduced-motion: reduce) {
    .b-bio {
      animation: none;
    }
  }
  .b-bio-tag {

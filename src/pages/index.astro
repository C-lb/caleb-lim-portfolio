  /* CARDS ROW — 12-col grid, each card spans 3 (four across). */
  .b-cards {
    display: grid;
    gap: clamp(12px, 1.4vw, 20px);
  }
  .b-cards > :global(.b-card) { grid-column: span 3; }

  /* Mobile collapse @ ≤900px (sketch lines 615-626) */
  @media (max-width: 900px) {
    .b-splash { padding: var(--sp-5); }
    .b-hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    /* Reset the 12-col spans so the hero stacks in one column. */
    .b-hero > .b-portrait,
    .b-hero > .b-name,
    .b-hero > .b-bio { grid-column: auto; }
    .b-portrait { aspect-ratio: 4/3; transform: none; }
    .b-cards { grid-template-columns: 1fr 1fr !important; }
    .b-cards > :global(.b-card) { grid-column: span 1; }
    /* 2026-05-18 (UAT): keep the question + arrow on the same flex row even on
       mobile so the down-arrow rides the right edge of the same line as
       "What do you wish to see?", instead of dropping below it. The .marker
       still stacks above via grid below. */
    .b-question { flex-direction: row; align-items: center; flex-wrap: wrap; }
    .b-question .marker { order: -1; flex-basis: 100%; }
    .b-question .q { flex: 1 1 0; min-width: 0; }
    /* Bio card silhouette pushed off the text on narrow screens: shrunk so it
       sits as a small corner glyph instead of a half-card watermark. */
    .b-bio-mark :global(svg) { width: 72px; height: 72px; }
    .b-bio-mark { bottom: 4px; left: 4px; opacity: 0.3; }
    .b-bio p { max-width: 100%; }
  }
  /* Tighter mobile @ ≤520px — single-column cards + further-shrunk decorations
     so the card-name and meta text dominate the read instead of competing with
     the deco glyphs. */
  @media (max-width: 520px) {
    .b-bio-mark :global(svg) { width: 56px; height: 56px; }
    .b-bio-mark { opacity: 0.25; }
  }
  /* Phones (≤700px): the discipline cards become a horizontal swipe carousel
     instead of stacking. display:flex makes the grid-template rules above inert.
     Each card snaps; the next peeks (flex-basis 80%) so the swipe affordance reads,
     and a thin terracotta scrollbar reinforces it. No JS — native scroll-snap. */
  @media (max-width: 700px) {
    /* Portrait fills the top of the screen but stays inset from the edges — it spans
       the full content width (not the 260px cap) with a tall portrait crop, keeping
       the splash padding as a margin on all sides and its rounded corners + shadow. */
    .b-portrait {
      max-width: none;
      width: 100%;
      aspect-ratio: 4 / 5;
    }
    .b-cards {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: var(--sp-3);
